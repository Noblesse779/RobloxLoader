# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000
NODE_ENV=development

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Used only once by "npm run seed" to create the first admin account.
# Leave ADMIN_PASSWORD unset after the first run so the seed script won't try to recreate it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
