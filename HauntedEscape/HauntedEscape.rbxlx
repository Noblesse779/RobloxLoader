}, gui)
corner(endFrame, 0.06)
make("UIStroke", { Color = Color3.fromRGB(255, 210, 90), Thickness = 2 }, endFrame)
make("UISizeConstraint", { MaxSize = Vector2.new(420, 260) }, endFrame)
