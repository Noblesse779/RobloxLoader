<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
<Item class="ReplicatedStorage" referent="RBX00000004"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000003"><Properties><string name="Name">HorrorShared</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--[[
	Config : ตั้งค่าทั้งหมดของเกม HAUNTED ESCAPE
	อยากปรับความยาก / ความเร็วผี / เสียง แก้ที่ไฟล์นี้ไฟล์เดียว
]]

local Config = {}

Config.GameTitle = "HAUNTED ESCAPE"
Config.GameSubtitle = "หนีให้รอด 4 ด่าน"

-- ===== ล็อบบี้ =====
Config.PartySizes = { 1, 2, 3, 4, 5, 6 } -- แท่นทีม 1-6 คน
Config.LobbyCountdown = 10 -- นับถอยหลังกี่วินาทีเมื่อคนบนแท่นครบ
Config.WaitForPartyTimeout = 25 -- (เซิร์ฟเวอร์เกม) รอเพื่อนเข้ามาให้ครบสูงสุดกี่วินาที
Config.RemoveBaseplate = true -- ลบ Baseplate เดิมของเพลสทิ้งอัตโนมัติ

-- ===== ผู้เล่น =====
Config.WalkSpeed = 14
Config.SprintSpeed = 24
Config.StaminaMax = 100
Config.StaminaDrain = 28 -- ลดต่อวินาทีตอนวิ่ง
Config.StaminaRegen = 16 -- ฟื้นต่อวินาที
Config.RespawnTime = 4
Config.FirstPerson = true -- บังคับมุมมองบุคคลที่หนึ่งในด่าน (ตุ้งแช่จะน่ากลัวกว่า)

-- ===== ตำแหน่งพื้นที่ต่าง ๆ บนแมพ (ห่างกันมากพอจะไม่เห็นกัน) =====
Config.Origins = {
	Lobby = Vector3.new(0, 0, 0),
	[1] = Vector3.new(0, 0, 1000),
	[2] = Vector3.new(0, 0, 2000),
	[3] = Vector3.new(0, 0, 3000),
	[4] = Vector3.new(0, 0, 4000),
	[5] = Vector3.new(0, 0, 5000), -- หน้าจบ
}

Config.Stages = {
	[1] = {
		Name = "ด่าน 1 : ทางเดินป่าช้า",
		Objective = "เดินไปให้สุดทางแล้วเข้าประตูวาป... อย่าหยุดเดิน",
	},
	[2] = {
		Name = "ด่าน 2 : บ้านร้าง",
		Objective = "หากุญแจเพื่อเปิดประตูทางออก (ระวังผีไล่!)",
	},
	[3] = {
		Name = "ด่าน 3 : สุสานต้องสาป",
		Objective = "เก็บเทียนวิญญาณ แล้วนำไปวางที่แท่นบูชากลางสุสาน",
	},
	[4] = {
		Name = "ด่าน 4 : โรงพยาบาลร้าง",
		Objective = "หาฟิวส์ไปใส่เครื่องปั่นไฟที่จุดเริ่มต้น แล้วหนีออกไป",
	},
	[5] = {
		Name = "หนีรอดแล้ว!",
		Objective = "ยินดีด้วย... คุณรอดชีวิตจากคืนนี้",
	},
}

-- ===== ผี =====
-- Count = จำนวนผีเริ่มต้น, ExtraPer = เพิ่มผี 1 ตัวทุก ๆ X คนในทีม
Config.Ghosts = {
	Stage2 = { Count = 1, ExtraPer = 3, Speed = 13, Damage = 35, DetectRange = 90 },
	Stage3 = { Count = 3, ExtraPer = 2, Speed = 11, Damage = 20, DetectRange = 60, Health = 100, RespawnDelay = 12 },
	Boss = { Speed = 10, Damage = 30, DetectRange = 250, Health = 300, HealthPerPlayer = 120, Scale = 2 },
	Stage4 = { Count = 2, ExtraPer = 3, Speed = 15, Damage = 40, DetectRange = 100, RageSpeed = 18 },
	SpawnDelay = 6, -- วินาทีก่อนผีออกมาหลังเข้าด่าน
}

-- ===== อาวุธด่าน 3 =====
Config.Weapon = {
	Name = "ไม้กางเขนศักดิ์สิทธิ์",
	Damage = 34,
	Range = 14,
	Cooldown = 0.6,
}

-- ===== เควส =====
Config.Quest = {
	Candles = 5, -- ด่าน 3
	Fuses = 4, -- ด่าน 4
}

-- ===== เสียง =====
-- ใส่ Sound ID จาก Toolbox / Creator Store ได้เลย เช่น "rbxassetid://1234567890"
-- ถ้าเว้นว่างไว้ เกมยังเล่นได้ปกติ แค่ไม่มีเสียงนั้น
Config.Sounds = {
	Jumpscare = "", -- เสียงกรีดร้องตอนตุ้งแช่
	Whisper = "", -- เสียงกระซิบ
	Heartbeat = "", -- เสียงหัวใจเต้น (เล่นวนตอนผีอยู่ใกล้)
	Ambience = "", -- เสียงบรรยากาศในด่าน (เล่นวน)
	LobbyMusic = "", -- เพลงในล็อบบี้ (เล่นวน)
	Pickup = "", -- เก็บของ
	Door = "", -- ประตูเปิด
	Portal = "", -- วาป
	Hit = "", -- โดนผีตี
	Victory = "", -- หน้าจบ
}

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">GhostModel</string><ProtectedString name="Source"><![CDATA[--[[
	GhostModel : สร้างโมเดลผีจากพาร์ทล้วน ๆ (ไม่ต้องใช้ asset)
	ใช้ทั้งฝั่งเซิร์ฟเวอร์ (ผีไล่) และฝั่งไคลเอนต์ (ผีตุ้งแช่)
	ด้านหน้าของผี = LookVector ของ PrimaryPart
]]

local GhostModel = {}

GhostModel.HeadHeight = 3.2 -- ระยะจากจุดกลางตัวถึงหัว (คูณ scale)

local function add(model, root, name, size, offset, color, material, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = root.CFrame * offset
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape == "Ellipsoid" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	elseif shape then
		p.Shape = shape
	end
	p.Parent = model
	return p
end

function GhostModel.create(opts)
	opts = opts or {}
	local s = opts.scale or 1
	local skin = opts.color or Color3.fromRGB(225, 225, 232)
	local black = Color3.fromRGB(8, 8, 10)

	local model = Instance.new("Model")
	model.Name = opts.name or "Ghost"

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(2, 2, 2) * s
	root.CFrame = CFrame.new()
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Parent = model
	model.PrimaryPart = root

	-- ตัว (ชุดขาวยาว)
	local body = add(model, root, "Body", Vector3.new(3, 5.5, 2.6) * s, CFrame.new(0, -0.4 * s, 0), skin, nil, "Ellipsoid")
	body.Transparency = 0.15

	-- ชายผ้าขาด ๆ ด้านล่าง
	for i = -1, 1 do
		add(model, root, "Rag", Vector3.new(0.7, 2.2, 0.4) * s,
			CFrame.new(i * 0.9 * s, -2.9 * s, -0.4 * s) * CFrame.Angles(0, 0, math.rad(i * 12)), skin).Transparency = 0.3
	end

	-- หัว
	local h = GhostModel.HeadHeight * s
	add(model, root, "Head", Vector3.new(2.3, 2.6, 2.3) * s, CFrame.new(0, h, 0), skin, nil, "Ellipsoid")

	-- ตาดำโบ๋ + ลูกตาแดง
	for _, x in ipairs({ -0.45, 0.45 }) do
		add(model, root, "Eye", Vector3.new(0.65, 0.8, 0.4) * s, CFrame.new(x * s, h + 0.25 * s, -1.0 * s), black, nil, "Ellipsoid")
		add(model, root, "Pupil", Vector3.new(0.22, 0.22, 0.22) * s, CFrame.new(x * s, h + 0.25 * s, -1.2 * s),
			Color3.fromRGB(255, 20, 20), Enum.Material.Neon, Enum.PartType.Ball)
		-- คราบเลือดไหลจากตา
		add(model, root, "Blood", Vector3.new(0.12, 0.9, 0.1) * s, CFrame.new(x * s, h - 0.4 * s, -1.08 * s),
			Color3.fromRGB(120, 0, 0))
	end

	-- ปากอ้ากว้าง
	add(model, root, "Mouth", Vector3.new(0.55, 0.9, 0.4) * s, CFrame.new(0, h - 0.6 * s, -0.98 * s), black, nil, "Ellipsoid")

	-- ผมดำยาว
	add(model, root, "HairBack", Vector3.new(2.5, 4.5, 0.6) * s, CFrame.new(0, h - 1.2 * s, 0.85 * s), black)
	add(model, root, "HairTop", Vector3.new(2.5, 0.8, 2.4) * s, CFrame.new(0, h + 1.05 * s, 0.05 * s), black)
	for _, x in ipairs({ -1.15, 1.15 }) do
		add(model, root, "HairSide", Vector3.new(0.45, 4.2, 1.8) * s, CFrame.new(x * s, h - 1.0 * s, -0.1 * s), black)
	end

	-- แขนยื่นมาข้างหน้า
	for _, x in ipairs({ -1.5, 1.5 }) do
		add(model, root, "Arm", Vector3.new(0.45, 0.45, 3.2) * s,
			CFrame.new(x * s, 1.2 * s, -1.5 * s) * CFrame.Angles(math.rad(-10), math.rad(-x * 4), 0), skin)
		add(model, root, "Hand", Vector3.new(0.6, 0.25, 0.9) * s, CFrame.new(x * s, 1.0 * s, -3.2 * s), skin)
	end

	-- แสงแดงจาง ๆ รอบตัว
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 60, 60)
	glow.Range = 10 * s
	glow.Brightness = 0.8
	glow.Shadows = false
	glow.Parent = root

	return model
end

return GhostModel
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX00000011"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000010"><Properties><string name="Name">HorrorServer</string><ProtectedString name="Source"><![CDATA[--[[
	HAUNTED ESCAPE - Server
	วางสคริปต์นี้ (ชื่อ HorrorServer) ไว้ใน ServerScriptService
	โดยมี ModuleScript ลูก: MapBuilder, Ghosts, Remotes, Run, Lobby
]]

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("HorrorShared"):WaitForChild("Config"))
local MapBuilder = require(script.MapBuilder)
local Run = require(script.Run)
local Lobby = require(script.Lobby)
local Remotes = require(script.Remotes)

Players.RespawnTime = Config.RespawnTime

-- แสงพื้นฐาน (ไคลเอนต์จะปรับตามด่านอีกที)
Lighting.ClockTime = 0
Lighting.Brightness = 1
Lighting.GlobalShadows = true
Lighting.Ambient = Color3.fromRGB(30, 28, 36)
Lighting.OutdoorAmbient = Color3.fromRGB(30, 28, 36)

local map = MapBuilder.build()

-- Reserved Server (ที่ล็อบบี้สร้างให้ทีม) => เป็นเซิร์ฟเวอร์เกม
local isGameServer = game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0

Run.init(map, isGameServer)
Lobby.init(map, Run, isGameServer)

if isGameServer then
	local expected

	local function readPartySize(p)
		local ok, data = pcall(function()
			return p:GetJoinData().TeleportData
		end)
		if ok and type(data) == "table" and tonumber(data.partySize) then
			expected = math.max(expected or 0, tonumber(data.partySize))
		end
	end

	Players.PlayerAdded:Connect(function(p)
		readPartySize(p)
		if Run.Active then
			-- หลุดแล้วกลับเข้ามาใหม่ => ต่อด่านเดิม
			if not p.Character then
				p.CharacterAdded:Wait()
			end
			task.wait(0.5)
			Run.addPlayer(p)
		end
	end)
	for _, p in ipairs(Players:GetPlayers()) do
		readPartySize(p)
	end

	task.spawn(function()
		while #Players:GetPlayers() == 0 do
			Players.PlayerAdded:Wait()
		end
		local t0 = os.clock()
		while #Players:GetPlayers() < (expected or 1) and os.clock() - t0 < Config.WaitForPartyTimeout do
			for _, p in ipairs(Players:GetPlayers()) do
				Remotes.Notify:FireClient(p, string.format("รอเพื่อนร่วมทีม %d/%d ...", #Players:GetPlayers(), expected or 1), Color3.fromRGB(255, 220, 120))
			end
			task.wait(2)
		end
		-- รอให้ตัวละครโหลดครบ
		local deadline = os.clock() + 10
		repeat
			local ready = true
			for _, p in ipairs(Players:GetPlayers()) do
				if not p.Character then
					ready = false
				end
			end
			task.wait(0.5)
		until ready or os.clock() > deadline
		task.wait(1.5)
		Run.start(Players:GetPlayers())
	end)
end
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Ghosts</string><ProtectedString name="Source"><![CDATA[--[[
	Ghosts : AI ผี (ลอยได้, ไล่ตามผู้เล่นด้วย Pathfinding, ทำดาเมจเมื่อเข้าใกล้)
	ผีทุกตัวอยู่ใน workspace.HorrorGhosts (ไคลเอนต์ใช้เช็คระยะเพื่อเล่นเสียงหัวใจ)
]]

local PathfindingService = game:GetService("PathfindingService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GhostModel = require(ReplicatedStorage:WaitForChild("HorrorShared"):WaitForChild("GhostModel"))

local Ghosts = {}
Ghosts.list = {}
Ghosts.onPlayerHit = nil -- function(player, ghost)

local ghostFolder = Instance.new("Folder")
ghostFolder.Name = "HorrorGhosts"
ghostFolder.Parent = workspace

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local PATH_INTERVAL = 0.5
local ATTACK_COOLDOWN = 1.2

local function aliveRoot(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if hum and root and hum.Health > 0 then
		return root, hum
	end
	return nil
end

local function makeHealthBar(g)
	local bb = Instance.new("BillboardGui")
	bb.Name = "HealthBar"
	bb.Size = UDim2.new(4 * g.scale, 0, 0.45, 0)
	bb.StudsOffset = Vector3.new(0, 5.6 * g.scale, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 80
	local back = Instance.new("Frame")
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Color3.fromRGB(20, 0, 0)
	back.BorderSizePixel = 0
	back.Parent = bb
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(220, 30, 30)
	fill.BorderSizePixel = 0
	fill.Parent = back
	bb.Parent = g.root
	g.healthFill = fill
end

function Ghosts.spawn(opts)
	local scale = opts.scale or 1
	local model = GhostModel.create({ scale = scale, name = opts.name or "Ghost", color = opts.color })
	local hover = 3.5 * scale
	local pos = opts.position + Vector3.new(0, hover, 0)
	model:PivotTo(CFrame.new(pos))
	model:SetAttribute("Stage", opts.stage)

	local g = {
		model = model,
		root = model.PrimaryPart,
		pos = pos,
		look = Vector3.new(0, 0, -1),
		hover = hover,
		scale = scale,
		stage = opts.stage,
		speed = opts.speed or 12,
		damage = opts.damage or 25,
		detect = opts.detectRange or 60,
		patrol = opts.patrolPoints or {},
		onDeath = opts.onDeath,
		waypoints = nil,
		wpIndex = 1,
		computing = false,
		lastCompute = 0,
		hitTimes = {},
		alive = true,
		invulnerable = opts.health == nil,
		bobT = math.random() * 10,
	}
	if opts.health then
		g.health = opts.health
		g.maxHealth = opts.health
		makeHealthBar(g)
	end
	model.Parent = ghostFolder
	table.insert(Ghosts.list, g)
	return g
end

local function computePath(g, goal)
	if g.computing then
		return
	end
	g.computing = true
	g.lastCompute = os.clock()
	task.spawn(function()
		local path = PathfindingService:CreatePath({
			AgentRadius = 2,
			AgentHeight = 5,
			AgentCanJump = false,
			AgentCanClimb = false,
			WaypointSpacing = 4,
		})
		local start = g.pos - Vector3.new(0, g.hover, 0)
		local ok = pcall(function()
			path:ComputeAsync(start, goal)
		end)
		if ok and path.Status == Enum.PathStatus.Success then
			g.waypoints = path:GetWaypoints()
			g.wpIndex = 2
		else
			g.waypoints = nil
		end
		g.computing = false
	end)
end

local function nearestTarget(g)
	local best, bestRoot, bestDist
	for _, player in ipairs(Players:GetPlayers()) do
		if player:GetAttribute("InRun") and player:GetAttribute("Stage") == g.stage then
			local root = aliveRoot(player)
			if root then
				local d = (root.Position - g.pos).Magnitude
				if d < g.detect and (not bestDist or d < bestDist) then
					best, bestRoot, bestDist = player, root, d
				end
			end
		end
	end
	return best, bestRoot, bestDist
end

local function hasLineOfSight(g, root)
	local filter = { ghostFolder }
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(filter, p.Character)
		end
	end
	rayParams.FilterDescendantsInstances = filter
	return workspace:Raycast(g.pos, root.Position - g.pos, rayParams) == nil
end

local function step(g, dt)
	local player, root, dist = nearestTarget(g)
	local speed = g.speed
	local goal

	if player then
		if dist < 16 and hasLineOfSight(g, root) then
			-- เห็นตัวแล้ว พุ่งตรงเข้าหา
			goal = root.Position + Vector3.new(0, g.hover - 3, 0)
			g.waypoints = nil
		elseif os.clock() - g.lastCompute > PATH_INTERVAL then
			computePath(g, root.Position - Vector3.new(0, 3, 0))
		end
	else
		speed *= 0.55
		local done = not g.waypoints or g.wpIndex > #g.waypoints
		if done and not g.computing and #g.patrol > 0 and os.clock() - g.lastCompute > 1 then
			computePath(g, g.patrol[math.random(#g.patrol)])
		end
	end

	if not goal and g.waypoints and g.wpIndex <= #g.waypoints then
		goal = g.waypoints[g.wpIndex].Position + Vector3.new(0, g.hover, 0)
		local flat = Vector3.new(goal.X - g.pos.X, 0, goal.Z - g.pos.Z)
		if flat.Magnitude < 1.5 then
			g.wpIndex += 1
		end
	elseif not goal and player then
		-- หาทางไม่ได้ => ลอยทะลุกำแพงเข้าไปเลย (ก็ผีนี่นา)
		goal = root.Position + Vector3.new(0, g.hover - 3, 0)
	end

	if goal then
		local delta = goal - g.pos
		local d = delta.Magnitude
		if d > 0.05 then
			g.pos += delta.Unit * math.min(d, speed * dt)
			local flat = Vector3.new(delta.X, 0, delta.Z)
			if flat.Magnitude > 0.1 then
				g.look = flat.Unit
			end
		end
	end

	g.bobT += dt
	local p = g.pos + Vector3.new(0, math.sin(g.bobT * 2.5) * 0.35 * g.scale, 0)
	g.model:PivotTo(CFrame.lookAt(p, p + g.look))

	-- โจมตี
	if player and root then
		if (root.Position - g.pos).Magnitude < 4.5 * g.scale then
			local last = g.hitTimes[player]
			if not last or os.clock() - last > ATTACK_COOLDOWN then
				g.hitTimes[player] = os.clock()
				local _, hum = aliveRoot(player)
				if hum then
					hum:TakeDamage(g.damage)
				end
				if Ghosts.onPlayerHit then
					Ghosts.onPlayerHit(player, g)
				end
			end
		end
	end
end

local function removeFromList(g)
	for i, other in ipairs(Ghosts.list) do
		if other == g then
			table.remove(Ghosts.list, i)
			return
		end
	end
end

function Ghosts.kill(g, silent)
	if not g.alive then
		return
	end
	g.alive = false
	removeFromList(g)
	for _, d in ipairs(g.model:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency < 1 then
			TweenService:Create(d, TweenInfo.new(0.6), { Transparency = 1 }):Play()
		elseif d:IsA("Light") then
			d.Enabled = false
		end
	end
	task.delay(0.7, function()
		g.model:Destroy()
	end)
	if g.onDeath and not silent then
		task.spawn(g.onDeath, g)
	end
end

function Ghosts.damage(g, amount)
	if not g.alive or g.invulnerable then
		return
	end
	g.health -= amount
	if g.healthFill then
		g.healthFill.Size = UDim2.fromScale(math.clamp(g.health / g.maxHealth, 0, 1), 1)
	end
	-- กระเด็นถอยหลัง + กะพริบขาว
	g.pos -= g.look * 3
	local hl = Instance.new("Highlight")
	hl.FillColor = Color3.fromRGB(255, 240, 180)
	hl.FillTransparency = 0.2
	hl.OutlineTransparency = 1
	hl.Parent = g.model
	TweenService:Create(hl, TweenInfo.new(0.3), { FillTransparency = 1 }):Play()
	task.delay(0.35, function()
		hl:Destroy()
	end)
	if g.health <= 0 then
		Ghosts.kill(g)
	end
end

function Ghosts.inRange(stage, position, range)
	local result = {}
	for _, g in ipairs(Ghosts.list) do
		if g.alive and g.stage == stage and (g.pos - position).Magnitude <= range + 2 * g.scale then
			table.insert(result, g)
		end
	end
	return result
end

function Ghosts.forStage(stage)
	local result = {}
	for _, g in ipairs(Ghosts.list) do
		if g.stage == stage then
			table.insert(result, g)
		end
	end
	return result
end

function Ghosts.clearStage(stage)
	for _, g in ipairs(Ghosts.forStage(stage)) do
		Ghosts.kill(g, true)
	end
end

local warned = false
RunService.Heartbeat:Connect(function(dt)
	for i = #Ghosts.list, 1, -1 do
		local g = Ghosts.list[i]
		if g and g.alive then
			local ok, err = pcall(step, g, dt)
			if not ok and not warned then
				warned = true
				warn("[Ghosts] " .. tostring(err))
			end
		end
	end
end)

return Ghosts
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Lobby</string><ProtectedString name="Source"><![CDATA[--[[
	Lobby : แท่นทีม 1-6 คน
	- ยืนบนแท่นให้ครบจำนวน => นับถอยหลัง => วาปทั้งทีมไปเซิร์ฟเวอร์เกมส่วนตัว (Reserved Server)
	- ถ้าเทสใน Studio หรือ Teleport ไม่ได้ => เล่นในเซิร์ฟเวอร์นี้เลย
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("HorrorShared"):WaitForChild("Config"))
local Remotes = require(script.Parent.Remotes)

local Lobby = {}

local function rootOf(p)
	local char = p.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if hum and root and hum.Health > 0 then
		return root
	end
	return nil
end

local function onPad(pad, root)
	local rel = root.Position - pad.Center
	return math.abs(rel.X) <= 6 and math.abs(rel.Z) <= 6 and rel.Y > 0 and rel.Y < 10
end

local function launch(pad, members, Run)
	pad.Launching = true
	pad.Status.Text = "กำลังเข้าเกม..."
	for _, p in ipairs(members) do
		Remotes.Transition:FireClient(p)
	end

	if not RunService:IsStudio() then
		local options = Instance.new("TeleportOptions")
		options.ShouldReserveServer = true
		options:SetTeleportData({ partySize = #members })
		local ok, err = pcall(function()
			TeleportService:TeleportAsync(game.PlaceId, members, options)
		end)
		if ok then
			task.delay(15, function()
				pad.Launching = false
			end)
			return
		end
		warn("[Lobby] Teleport failed, starting game in this server instead: " .. tostring(err))
	end

	Run.start(members)
	pad.Launching = false
end

function Lobby.init(map, Run, isGameServer)
	local pads = map.Lobby.Pads

	if isGameServer then
		for _, pad in ipairs(pads) do
			pad.Status.Text = "รอเพื่อนร่วมทีม..."
		end
		return
	end

	local lastFullWarn = {}

	task.spawn(function()
		while true do
			local claimed = {}
			for _, pad in ipairs(pads) do
				local members = {}
				for _, p in ipairs(Players:GetPlayers()) do
					if not claimed[p] and not p:GetAttribute("InRun") then
						local root = rootOf(p)
						if root and onPad(pad, root) then
							if #members < pad.Size then
								table.insert(members, p)
								claimed[p] = true
							elseif not lastFullWarn[p] or os.clock() - lastFullWarn[p] > 3 then
								lastFullWarn[p] = os.clock()
								Remotes.Notify:FireClient(p, "แท่นนี้เต็มแล้ว ลองแท่นอื่นนะ", Color3.fromRGB(255, 120, 120))
							end
						end
					end
				end

				if pad.Launching then
					continue -- กำลังวาปอยู่
				end
				if Run.Active then
					pad.CountStart = nil
					pad.Status.Text = "มีทีมกำลังเล่นอยู่..."
				elseif #members == pad.Size then
					pad.CountStart = pad.CountStart or os.clock()
					local remaining = math.ceil(Config.LobbyCountdown - (os.clock() - pad.CountStart))
					pad.Status.Text = "เริ่มใน " .. math.max(remaining, 0) .. " วิ!"
					if remaining <= 0 then
						pad.CountStart = nil
						task.spawn(launch, pad, members, Run)
					end
				else
					pad.CountStart = nil
					pad.Status.Text = #members .. "/" .. pad.Size .. " คน"
				end
			end
			task.wait(0.25)
		end
	end)
end

return Lobby
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	MapBuilder : สร้างแมพทั้งหมดด้วยโค้ด (ล็อบบี้, ด่าน 1-4, หน้าจบ)
	ทุกอย่างอยู่ใน workspace.HorrorMap
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("HorrorShared"):WaitForChild("Config"))

local MapBuilder = {}

local M = Enum.Material
local FLICKER_TAG = "HorrorFlicker"

-- ================= Helpers =================

local function folder(name, parent)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function part(parent, size, cf, color, material, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end

local function invisible(parent, size, cf, collide)
	return part(parent, size, cf, Color3.new(), M.SmoothPlastic, {
		Transparency = 1,
		CanCollide = collide == true,
		CanQuery = collide == true,
		CanTouch = false,
		CastShadow = false,
	})
end

local function light(parent, color, range, brightness, flicker)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = true
	l:SetAttribute("BaseBrightness", brightness)
	l.Parent = parent
	if flicker then
		CollectionService:AddTag(l, FLICKER_TAG)
	end
	return l
end

-- ป้ายพร้อมข้อความ entries = { {Text=, Font=, Color=, Weight=} }
local function sign(parent, size, cf, entries, bg)
	local p = part(parent, size, cf, bg or Color3.fromRGB(22, 16, 18), M.Wood)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 30
	sg.LightInfluence = 0
	sg.Parent = p
	local total = 0
	for _, e in ipairs(entries) do
		total += e.Weight or 1
	end
	local y = 0
	for _, e in ipairs(entries) do
		local w = (e.Weight or 1) / total
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(0.94, w)
		t.Position = UDim2.fromScale(0.03, y)
		t.Text = e.Text
		t.Font = e.Font or Enum.Font.GothamBlack
		t.TextColor3 = e.Color or Color3.fromRGB(200, 20, 20)
		t.TextScaled = true
		t.TextStrokeTransparency = 0.4
		t.Parent = sg
		y += w
	end
	return p
end

-- ตัวหนังสือเลือดบนผนัง (แผ่นใส ลอยหน้าผนังเล็กน้อย)
local function writing(parent, pos, facing, text, width)
	local p = invisible(parent, Vector3.new(width or 12, 5, 0.1), CFrame.lookAt(pos, pos + facing))
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 30
	sg.LightInfluence = 1
	sg.Parent = p
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Text = text
	t.Font = Enum.Font.GothamBlack
	t.TextColor3 = Color3.fromRGB(140, 0, 0)
	t.TextScaled = true
	t.Rotation = math.random(-6, 6)
	t.Parent = sg
	return p
end

local function deadTree(parent, pos, rng)
	local h = rng:NextNumber(16, 30)
	local w = rng:NextNumber(1.6, 2.8)
	local color = Color3.fromRGB(42, 33, 27)
	part(parent, Vector3.new(w, h, w),
		CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(rng:NextNumber(-0.08, 0.08), rng:NextNumber(0, 6.28), rng:NextNumber(-0.08, 0.08)),
		color, M.Wood)
	for _ = 1, rng:NextInteger(2, 4) do
		local bh = rng:NextNumber(h * 0.45, h * 0.9)
		local len = rng:NextNumber(5, 10)
		local cf = CFrame.new(pos + Vector3.new(0, bh, 0))
			* CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
			* CFrame.Angles(math.rad(rng:NextNumber(35, 65)), 0, 0)
			* CFrame.new(0, len / 2, 0)
		part(parent, Vector3.new(w * 0.35, len, w * 0.35), cf, color, M.Wood, { CanCollide = false })
	end
end

local function lampPost(parent, pos, color)
	part(parent, Vector3.new(0.8, 9, 0.8), CFrame.new(pos + Vector3.new(0, 4.5, 0)), Color3.fromRGB(30, 26, 22), M.Wood)
	part(parent, Vector3.new(1.6, 0.3, 1.6), CFrame.new(pos + Vector3.new(0, 9.1, 0)), Color3.fromRGB(25, 25, 25), M.Metal)
	local bulb = part(parent, Vector3.new(1, 1.2, 1), CFrame.new(pos + Vector3.new(0, 8.4, 0)), color, M.Neon, { CanCollide = false })
	light(bulb, color, 20, 1.3, true)
	return bulb
end

local function portal(parent, base, color, s)
	s = s or 1
	local model = Instance.new("Model")
	model.Name = "Portal"
	local stone = Color3.fromRGB(45, 42, 48)
	part(model, Vector3.new(2, 13, 2) * s, base * CFrame.new(-5.5 * s, 6.5 * s, 0), stone, M.Slate)
	part(model, Vector3.new(2, 13, 2) * s, base * CFrame.new(5.5 * s, 6.5 * s, 0), stone, M.Slate)
	part(model, Vector3.new(13, 2, 2.4) * s, base * CFrame.new(0, 14 * s, 0), stone, M.Slate)
	local core = part(model, Vector3.new(9, 12, 0.6) * s, base * CFrame.new(0, 6.5 * s, 0), color, M.Neon, {
		Name = "PortalCore",
		CanCollide = false,
		Transparency = 0.3,
	})
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(color)
	pe.LightEmission = 1
	pe.Rate = 25
	pe.Lifetime = NumberRange.new(1, 2)
	pe.Speed = NumberRange.new(1, 3)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	pe.Parent = core
	light(core, color, 22, 2.5, false)
	core:SetAttribute("Active", true)
	model.Parent = parent
	return core
end

function MapBuilder.setPortal(core, active)
	core:SetAttribute("Active", active)
	core.Transparency = active and 0.3 or 1
	for _, c in ipairs(core:GetChildren()) do
		if c:IsA("ParticleEmitter") or c:IsA("Light") then
			c.Enabled = active
		end
	end
end

local function makeDoor(parent, size, cf, color, actionText)
	local door = part(parent, size, cf, color, M.WoodPlanks, { Name = "ExitDoor" })
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = "ประตูทางออก"
	prompt.HoldDuration = 0.6
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = door
	local obj = { Part = door, Prompt = prompt, IsOpen = false }
	function obj.open()
		obj.IsOpen = true
		prompt.Enabled = false
		door.CanCollide = false
		TweenService:Create(door, TweenInfo.new(1.4, Enum.EasingStyle.Quad), {
			CFrame = cf * CFrame.new(0, -(size.Y + 0.5), 0),
		}):Play()
	end
	function obj.close()
		obj.IsOpen = false
		prompt.Enabled = true
		door.CanCollide = true
		door.CFrame = cf
	end
	return obj
end

-- ของที่เก็บได้ (กุญแจ / เทียน / ฟิวส์)
function MapBuilder.makePickup(parent, pos, kind)
	local model = Instance.new("Model")
	model.Name = kind
	local main, objectText, lightColor
	if kind == "Key" then
		local gold = Color3.fromRGB(255, 200, 60)
		main = part(model, Vector3.new(0.35, 0.35, 1.8), CFrame.new(pos + Vector3.new(0, 0.3, 0)), gold, M.Metal, { CanCollide = false })
		part(model, Vector3.new(0.3, 1.1, 1.1), CFrame.new(pos + Vector3.new(0, 0.3, -1.2)), gold, M.Metal, { CanCollide = false })
		part(model, Vector3.new(0.3, 0.5, 0.25), CFrame.new(pos + Vector3.new(0, 0.05, 0.7)), gold, M.Metal, { CanCollide = false })
		objectText, lightColor = "กุญแจประตูทางออก", gold
	elseif kind == "Candle" then
		main = part(model, Vector3.new(0.6, 1.6, 0.6), CFrame.new(pos + Vector3.new(0, 0.8, 0)), Color3.fromRGB(235, 230, 215), M.SmoothPlastic, { CanCollide = false })
		local flame = part(model, Vector3.new(0.35, 0.5, 0.35), CFrame.new(pos + Vector3.new(0, 1.85, 0)), Color3.fromRGB(120, 200, 255), M.Neon, { CanCollide = false })
		local fire = Instance.new("Fire")
		fire.Size = 1
		fire.Heat = 3
		fire.Color = Color3.fromRGB(120, 200, 255)
		fire.SecondaryColor = Color3.fromRGB(255, 255, 255)
		fire.Parent = flame
		objectText, lightColor = "เทียนวิญญาณ", Color3.fromRGB(120, 200, 255)
	else -- Fuse
		main = part(model, Vector3.new(0.8, 1.6, 0.8), CFrame.new(pos + Vector3.new(0, 0.8, 0)), Color3.fromRGB(200, 190, 60), M.Metal, { CanCollide = false })
		part(model, Vector3.new(0.95, 0.25, 0.95), CFrame.new(pos + Vector3.new(0, 1.55, 0)), Color3.fromRGB(170, 170, 175), M.Metal, { CanCollide = false })
		part(model, Vector3.new(0.95, 0.25, 0.95), CFrame.new(pos + Vector3.new(0, 0.05, 0)), Color3.fromRGB(170, 170, 175), M.Metal, { CanCollide = false })
		part(model, Vector3.new(0.85, 0.2, 0.85), CFrame.new(pos + Vector3.new(0, 0.8, 0)), Color3.fromRGB(60, 255, 90), M.Neon, { CanCollide = false })
		objectText, lightColor = "ฟิวส์", Color3.fromRGB(60, 255, 90)
	end
	model.PrimaryPart = main
	light(main, lightColor, 10, 1.5, false)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "เก็บ"
	prompt.ObjectText = objectText
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Parent = main
	model.Parent = parent
	return model, prompt
end

-- ================= Maze (ใช้ในด่าน 2 และ 4) =================

local function buildMaze(f, p)
	local rng = Random.new(p.seed)
	local W, H, C, T, WH = p.W, p.H, p.C, p.thick, p.wallH
	local corner = p.corner

	-- hW[i][j] = ผนังแนวนอนที่ z = j*C ของคอลัมน์ i, vW[i][j] = ผนังแนวตั้งที่ x = i*C ของแถว j
	local hW, vW = {}, {}
	for i = 0, W - 1 do
		hW[i] = {}
		for j = 0, H do
			hW[i][j] = true
		end
	end
	for i = 0, W do
		vW[i] = {}
		for j = 0, H - 1 do
			vW[i][j] = true
		end
	end

	-- สุ่มสร้างเขาวงกต (recursive backtracker) => ทุกห้องเดินถึงกันแน่นอน
	local visited = {}
	local function key(i, j)
		return i * 1000 + j
	end
	local stack = { { p.entryI, 0 } }
	visited[key(p.entryI, 0)] = true
	while #stack > 0 do
		local cur = stack[#stack]
		local i, j = cur[1], cur[2]
		local options = {}
		if j + 1 < H and not visited[key(i, j + 1)] then
			table.insert(options, { i, j + 1, "N" })
		end
		if j - 1 >= 0 and not visited[key(i, j - 1)] then
			table.insert(options, { i, j - 1, "S" })
		end
		if i + 1 < W and not visited[key(i + 1, j)] then
			table.insert(options, { i + 1, j, "E" })
		end
		if i - 1 >= 0 and not visited[key(i - 1, j)] then
			table.insert(options, { i - 1, j, "W" })
		end
		if #options == 0 then
			table.remove(stack)
		else
			local o = options[rng:NextInteger(1, #options)]
			if o[3] == "N" then
				hW[i][j + 1] = false
			elseif o[3] == "S" then
				hW[i][j] = false
			elseif o[3] == "E" then
				vW[i + 1][j] = false
			else
				vW[i][j] = false
			end
			visited[key(o[1], o[2])] = true
			table.insert(stack, { o[1], o[2] })
		end
	end
	-- เปิดทางเพิ่มให้มีทางวน (หนีผีได้)
	for _ = 1, p.extra do
		if rng:NextNumber() < 0.5 then
			hW[rng:NextInteger(0, W - 1)][rng:NextInteger(1, H - 1)] = false
		else
			vW[rng:NextInteger(1, W - 1)][rng:NextInteger(0, H - 1)] = false
		end
	end

	-- พื้น + เพดาน
	part(f, Vector3.new(W * C + T, 1, H * C + T), CFrame.new(corner + Vector3.new(W * C / 2, -0.5, H * C / 2)), p.floorColor, p.floorMat)
	part(f, Vector3.new(W * C + T, 1, H * C + T), CFrame.new(corner + Vector3.new(W * C / 2, WH + 0.5, H * C / 2)), p.ceilColor, M.Concrete)

	-- เสามุม
	for i = 0, W do
		for j = 0, H do
			part(f, Vector3.new(T, WH, T), CFrame.new(corner + Vector3.new(i * C, WH / 2, j * C)), p.wallColor, p.wallMat)
		end
	end

	local L = C - T
	local exitI = p.exitI
	for i = 0, W - 1 do
		for j = 0, H do
			if hW[i][j] and not (j == H and i == exitI) then
				part(f, Vector3.new(L, WH, T), CFrame.new(corner + Vector3.new((i + 0.5) * C, WH / 2, j * C)), p.wallColor, p.wallMat)
			end
		end
	end
	for i = 0, W do
		for j = 0, H - 1 do
			if vW[i][j] then
				part(f, Vector3.new(T, WH, L), CFrame.new(corner + Vector3.new(i * C, WH / 2, (j + 0.5) * C)), p.wallColor, p.wallMat)
			end
		end
	end

	-- ประตูทางออก (ผนังทิศเหนือของช่อง exitI)
	local doorW, doorH = 8, 11
	local side = (L - doorW) / 2
	local dz = H * C
	local dx = (exitI + 0.5) * C
	part(f, Vector3.new(side, WH, T), CFrame.new(corner + Vector3.new(dx - doorW / 2 - side / 2, WH / 2, dz)), p.wallColor, p.wallMat)
	part(f, Vector3.new(side, WH, T), CFrame.new(corner + Vector3.new(dx + doorW / 2 + side / 2, WH / 2, dz)), p.wallColor, p.wallMat)
	part(f, Vector3.new(doorW, WH - doorH, T), CFrame.new(corner + Vector3.new(dx, doorH + (WH - doorH) / 2, dz)), p.wallColor, p.wallMat)
	local door = makeDoor(f, Vector3.new(doorW, doorH, T * 0.8), CFrame.new(corner + Vector3.new(dx, doorH / 2, dz)), p.doorColor, p.doorText)

	-- ห้องหลังประตู
	local rz = (H + 0.5) * C
	part(f, Vector3.new(C + T, 1, C), CFrame.new(corner + Vector3.new(dx, -0.5, rz)), p.floorColor, p.floorMat)
	part(f, Vector3.new(C + T, 1, C), CFrame.new(corner + Vector3.new(dx, WH + 0.5, rz)), p.ceilColor, M.Concrete)
	part(f, Vector3.new(T, WH, L), CFrame.new(corner + Vector3.new(exitI * C, WH / 2, rz)), p.wallColor, p.wallMat)
	part(f, Vector3.new(T, WH, L), CFrame.new(corner + Vector3.new((exitI + 1) * C, WH / 2, rz)), p.wallColor, p.wallMat)
	part(f, Vector3.new(C + T, WH, T), CFrame.new(corner + Vector3.new(dx, WH / 2, (H + 1) * C)), p.wallColor, p.wallMat)
	local portalBase = CFrame.lookAt(corner + Vector3.new(dx, 0, (H + 0.65) * C), corner + Vector3.new(dx, 0, 0))
	local portalCore = portal(f, portalBase, p.portalColor, 0.8)

	-- ช่องต่าง ๆ
	local function center(i, j)
		return corner + Vector3.new((i + 0.5) * C, 0, (j + 0.5) * C)
	end
	local cells, deadEnds = {}, {}
	for i = 0, W - 1 do
		for j = 0, H - 1 do
			local c = center(i, j)
			table.insert(cells, { i = i, j = j, pos = c })
			local n = (hW[i][j] and 1 or 0) + (hW[i][j + 1] and 1 or 0) + (vW[i][j] and 1 or 0) + (vW[i + 1][j] and 1 or 0)
			local special = (i == p.entryI and j == 0) or (i == exitI and j == H - 1)
			if n >= 3 and not special then
				table.insert(deadEnds, { i = i, j = j, pos = c })
			end
		end
	end

	-- ไฟเพดาน (กะพริบ)
	local lamps = {}
	for _, cell in ipairs(cells) do
		local isEntry = cell.i == p.entryI and cell.j == 0
		if isEntry or rng:NextNumber() < p.lampChance then
			local lamp = part(f, Vector3.new(2.5, 0.3, 2.5), CFrame.new(cell.pos + Vector3.new(0, WH - 0.15, 0)), p.lampColor, M.Neon, { CanCollide = false })
			local l = light(lamp, p.lampColor, 22, 0.8, true)
			table.insert(lamps, { Part = lamp, Light = l })
		end
	end

	-- ตัวหนังสือเลือดบนผนัง
	local writingsLeft = p.writings and #p.writings or 0
	local tries = 0
	while writingsLeft > 0 and tries < 200 do
		tries += 1
		local i, j = rng:NextInteger(0, W - 1), rng:NextInteger(1, H - 1)
		if hW[i][j] then
			writing(f, corner + Vector3.new((i + 0.5) * C, WH * 0.5, j * C - T / 2 - 0.06), Vector3.new(0, 0, -1), p.writings[writingsLeft], L - 4)
			writingsLeft -= 1
		end
	end

	return {
		hW = hW,
		vW = vW,
		C = C,
		T = T,
		WH = WH,
		center = center,
		cells = cells,
		deadEnds = deadEnds,
		door = door,
		portal = portalCore,
		lamps = lamps,
		entry = center(p.entryI, 0),
		rng = rng,
	}
end

-- ================= ล็อบบี้ =================

local PAD_COLORS = {
	Color3.fromRGB(255, 60, 60),
	Color3.fromRGB(255, 140, 40),
	Color3.fromRGB(240, 220, 60),
	Color3.fromRGB(80, 220, 90),
	Color3.fromRGB(60, 160, 255),
	Color3.fromRGB(190, 80, 255),
}

local function buildLobby(root)
	local O = Config.Origins.Lobby
	local f = folder("Lobby", root)
	local W, D, H = 130, 110, 26
	local wallColor = Color3.fromRGB(48, 40, 44)

	part(f, Vector3.new(W, 2, D), CFrame.new(O + Vector3.new(0, -1, 0)), Color3.fromRGB(58, 40, 30), M.WoodPlanks)
	part(f, Vector3.new(14, 0.2, 66), CFrame.new(O + Vector3.new(0, 0.1, 8)), Color3.fromRGB(95, 12, 18), M.Fabric)
	part(f, Vector3.new(W, H, 2), CFrame.new(O + Vector3.new(0, H / 2, -D / 2)), wallColor, M.Brick)
	part(f, Vector3.new(W, H, 2), CFrame.new(O + Vector3.new(0, H / 2, D / 2)), wallColor, M.Brick)
	part(f, Vector3.new(2, H, D), CFrame.new(O + Vector3.new(-W / 2, H / 2, 0)), wallColor, M.Brick)
	part(f, Vector3.new(2, H, D), CFrame.new(O + Vector3.new(W / 2, H / 2, 0)), wallColor, M.Brick)
	part(f, Vector3.new(W, 2, D), CFrame.new(O + Vector3.new(0, H + 1, 0)), Color3.fromRGB(30, 24, 26), M.Wood)

	-- เสา + เทียนข้างผนัง
	for i = -2, 2 do
		for _, sd in ipairs({ -1, 1 }) do
			local x, z = sd * (W / 2 - 4), i * 20
			part(f, Vector3.new(3, H, 3), CFrame.new(O + Vector3.new(x, H / 2, z)), Color3.fromRGB(35, 30, 32), M.Marble)
			part(f, Vector3.new(0.6, 1.2, 0.6), CFrame.new(O + Vector3.new(x - sd * 1.9, 9, z)), Color3.fromRGB(240, 230, 200))
			local flame = part(f, Vector3.new(0.4, 0.6, 0.4), CFrame.new(O + Vector3.new(x - sd * 1.9, 9.9, z)), Color3.fromRGB(255, 170, 60), M.Neon, { CanCollide = false })
			light(flame, Color3.fromRGB(255, 150, 60), 16, 1.2, true)
		end
	end

	-- โคมระย้า
	local chPos = O + Vector3.new(0, H - 5, 8)
	part(f, Vector3.new(0.4, 4, 0.4), CFrame.new(chPos + Vector3.new(0, 3, 0)), Color3.fromRGB(40, 35, 25), M.Metal)
	local ch = part(f, Vector3.new(7, 0.6, 7), CFrame.new(chPos), Color3.fromRGB(70, 55, 30), M.Metal, { CanCollide = false })
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		part(f, Vector3.new(0.4, 0.8, 0.4), CFrame.new(chPos + Vector3.new(math.cos(a) * 3, 0.7, math.sin(a) * 3)), Color3.fromRGB(255, 170, 70), M.Neon, { CanCollide = false })
	end
	light(ch, Color3.fromRGB(255, 160, 90), 45, 1.1, true)

	-- รูปภาพหลอน ๆ บนผนังข้าง
	for _, sd in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -10, 10, 30 }) do
			local pos = O + Vector3.new(sd * (W / 2 - 1.2), 13, z)
			part(f, Vector3.new(0.4, 8, 6), CFrame.new(pos), Color3.fromRGB(60, 45, 20), M.Wood)
			part(f, Vector3.new(0.2, 7, 5), CFrame.new(pos - Vector3.new(sd * 0.25, 0, 0)), Color3.fromRGB(15, 15, 18))
			for _, ez in ipairs({ -0.7, 0.7 }) do
				part(f, Vector3.new(0.2, 0.4, 0.4), CFrame.new(pos + Vector3.new(-sd * 0.4, 1, ez)), Color3.fromRGB(255, 30, 30), M.Neon, { CanCollide = false })
			end
		end
	end

	-- จุดเกิด
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.new(O + Vector3.new(0, 0.5, 38))
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Color = Color3.fromRGB(70, 10, 15)
	spawn.Material = M.Slate
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = f

	-- ป้ายชื่อเกม
	sign(f, Vector3.new(64, 12, 1), CFrame.lookAt(O + Vector3.new(0, 20, -D / 2 + 1.6), O + Vector3.new(0, 20, 0)), {
		{ Text = Config.GameTitle, Font = Enum.Font.Creepster, Color = Color3.fromRGB(220, 20, 20), Weight = 2 },
		{ Text = Config.GameSubtitle, Color = Color3.fromRGB(230, 220, 220), Weight = 1 },
	})

	-- ป้ายวิธีเล่น (ตั้งข้างจุดเกิด หันหน้าเข้าหาผู้เล่น)
	local function standingSign(pos, entries)
		local face = CFrame.lookAt(pos, Vector3.new(O.X, pos.Y, O.Z + 38))
		sign(f, Vector3.new(16, 9, 0.6), face, entries)
		for _, x in ipairs({ -6, 6 }) do
			part(f, Vector3.new(0.6, pos.Y - O.Y, 0.6), face * CFrame.new(x, -(pos.Y - O.Y) / 2, 0.5), Color3.fromRGB(40, 30, 24), M.Wood)
		end
	end
	standingSign(O + Vector3.new(24, 7, 22), {
		{ Text = "วิธีเล่น", Color = Color3.fromRGB(255, 200, 60), Weight = 1.3 },
		{ Text = "1. ยืนบนแท่นตามจำนวนคนในทีม", Color = Color3.new(1, 1, 1) },
		{ Text = "2. คนครบ = นับถอยหลังเข้าเกม", Color = Color3.new(1, 1, 1) },
		{ Text = "[Shift] วิ่ง   [F] ไฟฉาย", Color = Color3.new(1, 1, 1) },
		{ Text = "ผ่านให้ครบ 4 ด่านเพื่อหนีให้รอด!", Color = Color3.fromRGB(255, 80, 80) },
	})
	standingSign(O + Vector3.new(-24, 7, 22), {
		{ Text = "4 ด่านแห่งความกลัว", Color = Color3.fromRGB(255, 200, 60), Weight = 1.3 },
		{ Text = "1. ทางเดินป่าช้า - ตุ้งแช่", Color = Color3.new(1, 1, 1) },
		{ Text = "2. บ้านร้าง - หากุญแจ หนีผี", Color = Color3.new(1, 1, 1) },
		{ Text = "3. สุสาน - สู้ผี ทำเควส", Color = Color3.new(1, 1, 1) },
		{ Text = "4. โรงพยาบาล - ตุ้งแช่ หนีผี หาของ", Color = Color3.new(1, 1, 1) },
	})

	-- แท่นทีม
	local pads = {}
	for idx, size in ipairs(Config.PartySizes) do
		local x = -50 + (idx - 1) * 20
		local center = O + Vector3.new(x, 0, -30)
		local glow = PAD_COLORS[((idx - 1) % #PAD_COLORS) + 1]
		local pad = part(f, Vector3.new(12, 1, 12), CFrame.new(center + Vector3.new(0, 0.5, 0)), Color3.fromRGB(25, 20, 25), M.Slate, { Name = "Pad" .. size })
		for _, e in ipairs({ { 0, 6, 12.4, 0.6 }, { 0, -6, 12.4, 0.6 }, { 6, 0, 0.6, 12.4 }, { -6, 0, 0.6, 12.4 } }) do
			part(f, Vector3.new(e[3], 0.3, e[4]), CFrame.new(center + Vector3.new(e[1], 1.1, e[2])), glow, M.Neon, { CanCollide = false })
		end
		light(pad, glow, 14, 1.5, false)

		-- ซุ้มประตูด้านหลังแท่น
		local stone = Color3.fromRGB(40, 36, 40)
		part(f, Vector3.new(2, 16, 2), CFrame.new(center + Vector3.new(-6, 8, -8)), stone, M.Slate)
		part(f, Vector3.new(2, 16, 2), CFrame.new(center + Vector3.new(6, 8, -8)), stone, M.Slate)
		part(f, Vector3.new(14, 2, 2.4), CFrame.new(center + Vector3.new(0, 17, -8)), stone, M.Slate)
		part(f, Vector3.new(10, 15, 0.4), CFrame.new(center + Vector3.new(0, 7.5, -8.6)), Color3.fromRGB(5, 5, 8), M.SmoothPlastic)
		sign(f, Vector3.new(9, 2.6, 0.3), CFrame.lookAt(center + Vector3.new(0, 17, -6.6), center + Vector3.new(0, 17, 10)), {
			{ Text = "ทีม " .. size .. " คน", Color = glow },
		}, Color3.fromRGB(15, 12, 14))

		local anchor = invisible(f, Vector3.new(1, 1, 1), CFrame.new(center + Vector3.new(0, 7, 0)))
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromOffset(220, 90)
		bb.AlwaysOnTop = true
		bb.MaxDistance = 120
		bb.LightInfluence = 0
		bb.Parent = anchor
		local title = Instance.new("TextLabel")
		title.BackgroundTransparency = 1
		title.Size = UDim2.fromScale(1, 0.55)
		title.Text = size .. " คน"
		title.Font = Enum.Font.GothamBlack
		title.TextScaled = true
		title.TextColor3 = glow
		title.TextStrokeTransparency = 0.3
		title.Parent = bb
		local status = Instance.new("TextLabel")
		status.BackgroundTransparency = 1
		status.Position = UDim2.fromScale(0, 0.55)
		status.Size = UDim2.fromScale(1, 0.45)
		status.Text = "0/" .. size
		status.Font = Enum.Font.GothamBold
		status.TextScaled = true
		status.TextColor3 = Color3.new(1, 1, 1)
		status.TextStrokeTransparency = 0.3
		status.Parent = bb

		pads[idx] = { Part = pad, Size = size, Center = center, Status = status, Billboard = bb }
	end

	return { Folder = f, Spawn = spawn, Pads = pads }
end

-- ================= ด่าน 1 : ทางเดินป่าช้า (ตุ้งแช่) =================

local function buildStage1(root)
	local O = Config.Origins[1]
	local f = folder("Stage1", root)
	local rng = Random.new(11)
	local LEN = 420

	part(f, Vector3.new(150, 2, LEN + 40), CFrame.new(O + Vector3.new(0, -1, LEN / 2)), Color3.fromRGB(30, 36, 24), M.Grass)
	part(f, Vector3.new(12, 0.2, LEN + 20), CFrame.new(O + Vector3.new(0, 0.1, LEN / 2)), Color3.fromRGB(62, 46, 33), M.Ground)
	invisible(f, Vector3.new(2, 40, LEN + 40), CFrame.new(O + Vector3.new(-17, 20, LEN / 2)), true)
	invisible(f, Vector3.new(2, 40, LEN + 40), CFrame.new(O + Vector3.new(17, 20, LEN / 2)), true)
	invisible(f, Vector3.new(36, 40, 2), CFrame.new(O + Vector3.new(0, 20, -6)), true)
	invisible(f, Vector3.new(36, 40, 2), CFrame.new(O + Vector3.new(0, 20, LEN + 6)), true)

	-- ต้นไม้ตาย
	for z = -10, LEN + 10, 8 do
		for _, sd in ipairs({ -1, 1 }) do
			if rng:NextNumber() < 0.8 then
				deadTree(f, O + Vector3.new(sd * rng:NextNumber(9, 15.5), 0, z + rng:NextNumber(-3, 3)), rng)
			end
			deadTree(f, O + Vector3.new(sd * rng:NextNumber(20, 70), 0, z + rng:NextNumber(-3, 3)), rng)
		end
	end

	-- เสาไฟริมทาง
	for z = 30, LEN - 20, 60 do
		local sd = (z / 60) % 2 == 0 and 1 or -1
		lampPost(f, O + Vector3.new(sd * 7.5, 0, z), Color3.fromRGB(255, 160, 80))
	end

	-- ป้ายทางเข้า
	sign(f, Vector3.new(10, 4, 0.4), CFrame.lookAt(O + Vector3.new(-8, 5, 18), O + Vector3.new(-8, 5, 0)) * CFrame.Angles(0, 0, math.rad(-6)), {
		{ Text = "ทางนี้...", Color = Color3.fromRGB(170, 0, 0) },
		{ Text = "ไม่มีใครกลับมา", Color = Color3.fromRGB(170, 0, 0) },
	}, Color3.fromRGB(50, 38, 28))
	part(f, Vector3.new(0.5, 6, 0.5), CFrame.new(O + Vector3.new(-8, 3, 18.4)), Color3.fromRGB(50, 38, 28), M.Wood)

	-- ศาลพระภูมิร้างกลางทาง
	local sp = O + Vector3.new(11, 0, 185)
	part(f, Vector3.new(0.8, 5, 0.8), CFrame.new(sp + Vector3.new(0, 2.5, 0)), Color3.fromRGB(150, 140, 130), M.Concrete)
	part(f, Vector3.new(4, 0.4, 4), CFrame.new(sp + Vector3.new(0, 5.2, 0)), Color3.fromRGB(140, 130, 120), M.Concrete)
	part(f, Vector3.new(3, 2.6, 3), CFrame.new(sp + Vector3.new(0, 6.7, 0)), Color3.fromRGB(150, 60, 40), M.Wood)
	part(f, Vector3.new(3.6, 0.5, 3.6), CFrame.new(sp + Vector3.new(0, 8.2, 0)) * CFrame.Angles(0, math.rad(45), 0), Color3.fromRGB(120, 40, 30), M.Wood)
	local candle = part(f, Vector3.new(0.3, 0.6, 0.3), CFrame.new(sp + Vector3.new(-1.2, 5.7, -1.4)), Color3.fromRGB(255, 120, 40), M.Neon, { CanCollide = false })
	light(candle, Color3.fromRGB(255, 120, 40), 10, 1, true)

	-- ผียืนนิ่ง ๆ ไกล ๆ ในป่า (แค่บรรยากาศ)
	local GhostModel = require(ReplicatedStorage.HorrorShared.GhostModel)
	for _, z in ipairs({ 120, 240, 340 }) do
		local g = GhostModel.create({ name = "WatchingGhost" })
		local x = (z % 240 == 0) and -30 or 32
		local pos = O + Vector3.new(x, 3.5, z)
		g:PivotTo(CFrame.lookAt(pos, Vector3.new(O.X, pos.Y, pos.Z)))
		g.Parent = f
	end

	-- จุดตุ้งแช่
	local triggers = {}
	local scares = { "Face", "Rush", "Blackout", "Drop", "Behind", "Rush", "Face" }
	for k, z in ipairs({ 45, 95, 150, 205, 265, 320, 375 }) do
		local t = invisible(f, Vector3.new(32, 14, 4), CFrame.new(O + Vector3.new(0, 7, z)))
		t.Name = "ScareTrigger"
		t.CanTouch = true
		t:SetAttribute("ScareType", scares[k])
		t:SetAttribute("Stage", 1)
		table.insert(triggers, t)
	end

	-- ประตูวาปท้ายทาง
	local base = CFrame.lookAt(O + Vector3.new(0, 0, LEN - 4), O + Vector3.new(0, 0, 0))
	local portalCore = portal(f, base, Color3.fromRGB(170, 60, 255), 1)

	local spawn = invisible(f, Vector3.new(1, 1, 1), CFrame.lookAt(O + Vector3.new(0, 3, 6), O + Vector3.new(0, 3, 50)))
	spawn.Name = "StageSpawn"

	return { Folder = f, Spawn = spawn, Portal = portalCore, Triggers = triggers }
end

-- ================= ด่าน 2 : บ้านร้าง (หากุญแจ + ผีไล่) =================

local function buildStage2(root)
	local O = Config.Origins[2]
	local f = folder("Stage2", root)
	local W, H, C = 7, 7, 20
	local corner = O + Vector3.new(-W * C / 2, 0, 0)
	local maze = buildMaze(f, {
		corner = corner, W = W, H = H, C = C, thick = 2, wallH = 14, seed = 22, extra = 9,
		entryI = 3, exitI = 3,
		floorColor = Color3.fromRGB(55, 38, 28), floorMat = M.WoodPlanks,
		wallColor = Color3.fromRGB(78, 64, 55), wallMat = M.WoodPlanks,
		ceilColor = Color3.fromRGB(35, 30, 28),
		lampChance = 0.3, lampColor = Color3.fromRGB(255, 175, 110),
		doorColor = Color3.fromRGB(70, 40, 25), doorText = "ไขกุญแจ",
		portalColor = Color3.fromRGB(170, 60, 255),
		writings = { "หนีไป...", "มันอยู่ข้างหลังแก", "ไม่มีทางออก", "ช่วยด้วย", "GET OUT", "อย่าหันไปมอง", "มันได้ยินแก", "กุญแจอยู่ไหน?" },
	})
	local rng = maze.rng

	-- โต๊ะตามทางตัน (กุญแจจะสุ่มอยู่บนโต๊ะตัวใดตัวหนึ่ง)
	local keySpots = {}
	local tableColor = Color3.fromRGB(60, 40, 28)
	for _, d in ipairs(maze.deadEnds) do
		local c = d.pos
		part(f, Vector3.new(5, 0.4, 3.5), CFrame.new(c + Vector3.new(0, 3, 0)), tableColor, M.Wood)
		for _, l in ipairs({ { -2.2, -1.4 }, { 2.2, -1.4 }, { -2.2, 1.4 }, { 2.2, 1.4 } }) do
			part(f, Vector3.new(0.4, 2.8, 0.4), CFrame.new(c + Vector3.new(l[1], 1.4, l[2])), tableColor, M.Wood)
		end
		table.insert(keySpots, c + Vector3.new(0, 3.2, 0))
	end
	if #keySpots == 0 then
		table.insert(keySpots, maze.center(W - 1, H - 1) + Vector3.new(0, 0.1, 0))
	end

	-- ของตกแต่ง: ลังไม้ตามมุมห้อง
	for _, cell in ipairs(maze.cells) do
		if rng:NextNumber() < 0.35 then
			local ox = (rng:NextNumber() < 0.5 and -1 or 1) * (C / 2 - 3.2)
			local oz = (rng:NextNumber() < 0.5 and -1 or 1) * (C / 2 - 3.2)
			part(f, Vector3.new(3, 3, 3), CFrame.new(cell.pos + Vector3.new(ox, 1.5, oz)) * CFrame.Angles(0, rng:NextNumber(0, 1), 0), Color3.fromRGB(90, 65, 40), M.Wood)
		end
	end

	local ghostSpawns = {
		maze.center(0, H - 1),
		maze.center(W - 1, H - 1),
		maze.center(W - 1, 2),
		maze.center(0, 3),
	}
	local patrol = {}
	for _, cell in ipairs(maze.cells) do
		table.insert(patrol, cell.pos)
	end

	local spawn = invisible(f, Vector3.new(1, 1, 1), CFrame.lookAt(maze.entry + Vector3.new(0, 3, 0), maze.entry + Vector3.new(0, 3, 10)))
	spawn.Name = "StageSpawn"

	return {
		Folder = f,
		Spawn = spawn,
		Portal = maze.portal,
		Door = maze.door,
		KeySpots = keySpots,
		GhostSpawns = ghostSpawns,
		Patrol = patrol,
		Dynamic = folder("Dynamic", f),
	}
end

-- ================= ด่าน 3 : สุสาน (สู้ผี + เควสเทียน) =================

local function tombstone(parent, pos, rng)
	local stone = Color3.fromRGB(rng:NextInteger(85, 115), rng:NextInteger(85, 110), rng:NextInteger(85, 110))
	local base = CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(-0.15, 0.15), 0)
	local tilt = CFrame.Angles(rng:NextNumber(-0.15, 0.15), 0, rng:NextNumber(-0.12, 0.12))
	if rng:NextNumber() < 0.7 then
		local h = rng:NextNumber(3, 5)
		part(parent, Vector3.new(3, h, 0.8), base * CFrame.new(0, h / 2 - 0.3, 0) * tilt, stone, M.Slate)
	else
		part(parent, Vector3.new(0.6, 5, 0.6), base * CFrame.new(0, 2.3, 0) * tilt, stone, M.Slate)
		part(parent, Vector3.new(2.8, 0.6, 0.6), base * tilt * CFrame.new(0, 3.5, 0), stone, M.Slate)
	end
	part(parent, Vector3.new(3.2, 0.7, 6), base * CFrame.new(0, 0.3, 3.4), Color3.fromRGB(55, 42, 32), M.Ground)
end

local function buildStage3(root)
	local O = Config.Origins[3]
	local f = folder("Stage3", root)
	local rng = Random.new(33)
	local S = 200
	local altar = O + Vector3.new(0, 0, 105)

	part(f, Vector3.new(S + 60, 2, S + 60), CFrame.new(O + Vector3.new(0, -1, S / 2)), Color3.fromRGB(28, 36, 26), M.Grass)
	part(f, Vector3.new(8, 0.2, S), CFrame.new(O + Vector3.new(0, 0.1, S / 2)), Color3.fromRGB(62, 50, 38), M.Ground)

	-- กำแพงล่องหน + รั้วเหล็ก
	invisible(f, Vector3.new(2, 50, S + 4), CFrame.new(O + Vector3.new(-S / 2 - 1, 25, S / 2)), true)
	invisible(f, Vector3.new(2, 50, S + 4), CFrame.new(O + Vector3.new(S / 2 + 1, 25, S / 2)), true)
	invisible(f, Vector3.new(S + 4, 50, 2), CFrame.new(O + Vector3.new(0, 25, -1)), true)
	invisible(f, Vector3.new(S + 4, 50, 2), CFrame.new(O + Vector3.new(0, 25, S + 1)), true)
	local iron = Color3.fromRGB(20, 20, 22)
	local stoneWall = Color3.fromRGB(70, 66, 62)
	for _, e in ipairs({
		{ Vector3.new(0, 0, 0), Vector3.new(S, 0, 1) },
		{ Vector3.new(0, 0, S), Vector3.new(S, 0, 1) },
		{ Vector3.new(-S / 2, 0, S / 2), Vector3.new(1, 0, S) },
		{ Vector3.new(S / 2, 0, S / 2), Vector3.new(1, 0, S) },
	}) do
		local c, sz = e[1], e[2]
		part(f, Vector3.new(sz.X, 2, sz.Z), CFrame.new(O + c + Vector3.new(0, 1, 0)), stoneWall, M.Cobblestone)
		part(f, Vector3.new(math.max(sz.X - 0.6, 0.4), 0.4, math.max(sz.Z - 0.6, 0.4)), CFrame.new(O + c + Vector3.new(0, 6, 0)), iron, M.Metal)
	end
	for t = -S / 2, S / 2, 8 do
		for _, pos in ipairs({ Vector3.new(t, 0, 0), Vector3.new(t, 0, S), Vector3.new(-S / 2, 0, t + S / 2), Vector3.new(S / 2, 0, t + S / 2) }) do
			part(f, Vector3.new(0.6, 7, 0.6), CFrame.new(O + pos + Vector3.new(0, 3.5, 0)), iron, M.Metal)
		end
	end
	for t = -S / 2 + 20, S / 2 - 20, 40 do
		lampPost(f, O + Vector3.new(t, 0, 3), Color3.fromRGB(150, 255, 160))
		lampPost(f, O + Vector3.new(t, 0, S - 3), Color3.fromRGB(150, 255, 160))
		lampPost(f, O + Vector3.new(-S / 2 + 3, 0, t + S / 2), Color3.fromRGB(150, 255, 160))
		lampPost(f, O + Vector3.new(S / 2 - 3, 0, t + S / 2), Color3.fromRGB(150, 255, 160))
	end

	-- หลุมศพ
	for z = 25, S - 25, 11 do
		for x = -S / 2 + 12, S / 2 - 12, 9 do
			local flat = Vector3.new(x, 0, z) - Vector3.new(0, 0, 105)
			if math.abs(x) > 7 and flat.Magnitude > 24 and rng:NextNumber() < 0.6 then
				tombstone(f, O + Vector3.new(x + rng:NextNumber(-2, 2), 0, z + rng:NextNumber(-2, 2)), rng)
			end
		end
	end

	-- ต้นไม้ตาย
	for _ = 1, 22 do
		local pos = O + Vector3.new(rng:NextNumber(-90, 90), 0, rng:NextNumber(15, 190))
		if (pos - altar).Magnitude > 26 and math.abs(pos.X - O.X) > 8 then
			deadTree(f, pos, rng)
		end
	end

	-- สุสานหลังเล็ก (ฮวงซุ้ย) 2 หลัง
	for _, c in ipairs({ Vector3.new(-72, 0, 175), Vector3.new(72, 0, 35) }) do
		local p = O + c
		local g = Color3.fromRGB(80, 78, 82)
		part(f, Vector3.new(16, 12, 14), CFrame.new(p + Vector3.new(0, 6, 0)), g, M.Granite)
		part(f, Vector3.new(18, 2, 16), CFrame.new(p + Vector3.new(0, 13, 0)), Color3.fromRGB(60, 58, 62), M.Slate)
		part(f, Vector3.new(12, 2, 11), CFrame.new(p + Vector3.new(0, 15, 0)), Color3.fromRGB(60, 58, 62), M.Slate)
		local dir = c.Z > 100 and -1 or 1
		part(f, Vector3.new(5, 8, 0.4), CFrame.new(p + Vector3.new(0, 4, dir * 7.1)), Color3.fromRGB(5, 5, 6))
		for _, x in ipairs({ -5, 5 }) do
			part(f, Vector3.new(1.4, 12, 1.4), CFrame.new(p + Vector3.new(x, 6, dir * 7.6)), g, M.Marble)
		end
	end

	-- แท่นบูชากลางสุสาน
	local stone = Color3.fromRGB(70, 68, 72)
	part(f, Vector3.new(18, 1.5, 18), CFrame.new(altar + Vector3.new(0, 0.75, 0)), stone, M.Slate)
	part(f, Vector3.new(12, 1, 12), CFrame.new(altar + Vector3.new(0, 2, 0)), Color3.fromRGB(90, 85, 92), M.Marble)
	local pillar = part(f, Vector3.new(2.5, 4, 2.5), CFrame.new(altar + Vector3.new(0, 4.5, 0)), Color3.fromRGB(40, 36, 40), M.Granite, { Name = "Altar" })
	local orb = part(f, Vector3.new(1.6, 1.6, 1.6), CFrame.new(altar + Vector3.new(0, 7.3, 0)), Color3.fromRGB(200, 0, 0), M.Neon, { Shape = Enum.PartType.Ball, CanCollide = false })
	light(orb, Color3.fromRGB(255, 0, 0), 18, 1.5, true)
	local altarPrompt = Instance.new("ProximityPrompt")
	altarPrompt.ActionText = "วางเทียน"
	altarPrompt.ObjectText = "แท่นบูชา"
	altarPrompt.HoldDuration = 1
	altarPrompt.MaxActivationDistance = 12
	altarPrompt.RequiresLineOfSight = false
	altarPrompt.Parent = pillar

	local slots = {}
	for k = 1, Config.Quest.Candles do
		local a = (k - 1) / Config.Quest.Candles * math.pi * 2
		local p = altar + Vector3.new(math.cos(a) * 4.8, 2.5, math.sin(a) * 4.8)
		part(f, Vector3.new(0.9, 1.6, 0.9), CFrame.new(p + Vector3.new(0, 0.8, 0)), Color3.fromRGB(50, 45, 50), M.Slate)
		local candle = part(f, Vector3.new(0.5, 1.2, 0.5), CFrame.new(p + Vector3.new(0, 2.2, 0)), Color3.fromRGB(235, 230, 215), M.SmoothPlastic, { CanCollide = false, Transparency = 1 })
		local flame = part(f, Vector3.new(0.3, 0.45, 0.3), CFrame.new(p + Vector3.new(0, 3.05, 0)), Color3.fromRGB(120, 200, 255), M.Neon, { CanCollide = false, Transparency = 1 })
		local l = light(flame, Color3.fromRGB(120, 200, 255), 12, 1.5, false)
		l.Enabled = false
		slots[k] = { Candle = candle, Flame = flame, Light = l }
	end
	local function setSlotLit(k, lit)
		local s = slots[k]
		if not s then
			return
		end
		s.Candle.Transparency = lit and 0 or 1
		s.Flame.Transparency = lit and 0 or 1
		s.Light.Enabled = lit
	end

	-- จุดที่เทียนอาจเกิด
	local candleSpots = {}
	local tries = 0
	while #candleSpots < 14 and tries < 500 do
		tries += 1
		local pos = O + Vector3.new(rng:NextNumber(-88, 88), 0, rng:NextNumber(25, 190))
		local ok = (pos - altar).Magnitude > 28
		for _, other in ipairs(candleSpots) do
			if (other - pos).Magnitude < 25 then
				ok = false
			end
		end
		if ok then
			table.insert(candleSpots, pos)
		end
	end

	local ghostSpawns = {
		O + Vector3.new(-80, 0, 60),
		O + Vector3.new(80, 0, 70),
		O + Vector3.new(-80, 0, 165),
		O + Vector3.new(80, 0, 150),
		O + Vector3.new(0, 0, 185),
	}
	local patrol = {}
	for _ = 1, 20 do
		table.insert(patrol, O + Vector3.new(rng:NextNumber(-85, 85), 0, rng:NextNumber(20, 190)))
	end

	local base = CFrame.lookAt(O + Vector3.new(0, 0, S - 8), O + Vector3.new(0, 0, 0))
	local portalCore = portal(f, base, Color3.fromRGB(170, 60, 255), 1)

	local spawn = invisible(f, Vector3.new(1, 1, 1), CFrame.lookAt(O + Vector3.new(0, 3, 8), O + Vector3.new(0, 3, 50)))
	spawn.Name = "StageSpawn"

	return {
		Folder = f,
		Spawn = spawn,
		Portal = portalCore,
		AltarPrompt = altarPrompt,
		SetSlotLit = setSlotLit,
		CandleSpots = candleSpots,
		GhostSpawns = ghostSpawns,
		BossSpawn = altar + Vector3.new(0, 0, 14),
		Patrol = patrol,
		Dynamic = folder("Dynamic", f),
	}
end

-- ================= ด่าน 4 : โรงพยาบาลร้าง (ตุ้งแช่ + ผีไล่ + หาฟิวส์) =================

local function buildStage4(root)
	local O = Config.Origins[4]
	local f = folder("Stage4", root)
	local W, H, C = 9, 9, 18
	local corner = O + Vector3.new(-W * C / 2, 0, 0)
	local entryI = 4
	local maze = buildMaze(f, {
		corner = corner, W = W, H = H, C = C, thick = 2, wallH = 13, seed = 44, extra = 14,
		entryI = entryI, exitI = 4,
		floorColor = Color3.fromRGB(150, 150, 140), floorMat = M.Marble,
		wallColor = Color3.fromRGB(120, 140, 125), wallMat = M.Concrete,
		ceilColor = Color3.fromRGB(90, 95, 90),
		lampChance = 0.35, lampColor = Color3.fromRGB(190, 255, 200),
		doorColor = Color3.fromRGB(110, 110, 115), doorText = "เปิดประตู",
		portalColor = Color3.fromRGB(255, 220, 120),
		writings = { "อย่าวิ่ง", "หมอยังอยู่ที่นี่", "ห้องผ่าตัด →", "ไฟดับ = ตาย", "ฉันเห็นแก", "HELP ME", "มันหิว", "ฟิวส์...", "ไม่มีใครรอด" },
	})
	local rng = maze.rng
	local C2 = C / 2

	-- ป้าย EXIT เหนือประตู
	local exitPos = corner + Vector3.new((4 + 0.5) * C, 12, H * C - 1.2)
	local exitSign = part(f, Vector3.new(5, 1.2, 0.3), CFrame.new(exitPos), Color3.fromRGB(255, 30, 30), M.Neon, { CanCollide = false })
	light(exitSign, Color3.fromRGB(255, 30, 30), 10, 1, true)

	-- เตียงคนไข้ (วางชิดผนังที่มีอยู่จริงเท่านั้น จะได้ไม่ขวางทาง)
	for _, cell in ipairs(maze.cells) do
		local hasEast = maze.vW[cell.i + 1][cell.j]
		if hasEast and rng:NextNumber() < 0.3 and not (cell.i == entryI and cell.j == 0) then
			local c = cell.pos + Vector3.new(C2 - 1 - 2.2, 0, 0)
			part(f, Vector3.new(3.6, 1.6, 7), CFrame.new(c + Vector3.new(0, 1.3, 0)), Color3.fromRGB(150, 150, 155), M.Metal)
			part(f, Vector3.new(3.3, 0.6, 6.6), CFrame.new(c + Vector3.new(0, 2.4, 0)), Color3.fromRGB(220, 215, 205), M.Fabric)
			part(f, Vector3.new(2, 0.05, 2.4), CFrame.new(c + Vector3.new(rng:NextNumber(-0.5, 0.5), 2.73, rng:NextNumber(-1.5, 1.5))), Color3.fromRGB(110, 0, 0), M.SmoothPlastic, { CanCollide = false })
		end
	end

	-- เครื่องปั่นไฟที่ห้องเริ่มต้น
	local gpos = maze.entry + Vector3.new(0, 0, -C2 + 1 + 1.8)
	local gen = part(f, Vector3.new(8, 5, 3.4), CFrame.new(gpos + Vector3.new(0, 2.5, 0)), Color3.fromRGB(150, 130, 40), M.DiamondPlate, { Name = "Generator" })
	sign(f, Vector3.new(6, 1.2, 0.2), CFrame.lookAt(gpos + Vector3.new(0, 4.3, 1.82), gpos + Vector3.new(0, 4.3, 10)), {
		{ Text = "เครื่องปั่นไฟ", Color = Color3.fromRGB(255, 230, 120) },
	}, Color3.fromRGB(30, 30, 30))
	local genSlots = {}
	for k = 1, Config.Quest.Fuses do
		local x = (k - (Config.Quest.Fuses + 1) / 2) * 1.6
		genSlots[k] = part(f, Vector3.new(0.8, 1.4, 0.2), CFrame.new(gpos + Vector3.new(x, 2.4, 1.82)), Color3.fromRGB(255, 30, 30), M.Neon, { CanCollide = false })
	end
	local genPrompt = Instance.new("ProximityPrompt")
	genPrompt.ActionText = "ใส่ฟิวส์"
	genPrompt.ObjectText = "เครื่องปั่นไฟ"
	genPrompt.HoldDuration = 1
	genPrompt.MaxActivationDistance = 10
	genPrompt.RequiresLineOfSight = false
	genPrompt.Parent = gen

	local function setFuseSlot(k, filled)
		if genSlots[k] then
			genSlots[k].Color = filled and Color3.fromRGB(60, 255, 90) or Color3.fromRGB(255, 30, 30)
		end
	end
	local function setPowered(on)
		for _, lamp in ipairs(maze.lamps) do
			local color = on and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(190, 255, 200)
			lamp.Part.Color = color
			lamp.Light.Color = color
			lamp.Light.Brightness = on and 1.6 or 0.8
			if on then
				CollectionService:RemoveTag(lamp.Light, FLICKER_TAG)
			else
				CollectionService:AddTag(lamp.Light, FLICKER_TAG)
			end
		end
	end

	-- รถเข็นตามทางตัน (ฟิวส์จะสุ่มอยู่บนรถเข็น)
	local fuseSpots = {}
	for _, d in ipairs(maze.deadEnds) do
		local c = d.pos
		part(f, Vector3.new(4, 0.4, 2.6), CFrame.new(c + Vector3.new(0, 2.8, 0)), Color3.fromRGB(170, 170, 175), M.Metal)
		part(f, Vector3.new(4, 0.3, 2.6), CFrame.new(c + Vector3.new(0, 1, 0)), Color3.fromRGB(170, 170, 175), M.Metal)
		for _, l in ipairs({ { -1.8, -1.1 }, { 1.8, -1.1 }, { -1.8, 1.1 }, { 1.8, 1.1 } }) do
			part(f, Vector3.new(0.25, 2.8, 0.25), CFrame.new(c + Vector3.new(l[1], 1.4, l[2])), Color3.fromRGB(120, 120, 125), M.Metal)
		end
		table.insert(fuseSpots, c + Vector3.new(0, 3, 0))
	end
	-- เผื่อทางตันมีน้อยกว่าจำนวนฟิวส์
	local cellsCopy = table.clone(maze.cells)
	while #fuseSpots < Config.Quest.Fuses + 2 and #cellsCopy > 0 do
		local cell = table.remove(cellsCopy, rng:NextInteger(1, #cellsCopy))
		if cell.j > 1 then
			table.insert(fuseSpots, cell.pos + Vector3.new(0, 0.1, 0))
		end
	end

	-- จุดตุ้งแช่ในตึก
	local triggers = {}
	local scares = { "Rush", "Face", "Blackout", "Drop", "Behind", "Rush", "Face", "Drop", "Blackout" }
	local pool = table.clone(maze.cells)
	for k = 1, #scares do
		local cell
		repeat
			cell = table.remove(pool, rng:NextInteger(1, #pool))
		until #pool == 0 or cell.j > 0
		local t = invisible(f, Vector3.new(C - 4, 10, C - 4), CFrame.new(cell.pos + Vector3.new(0, 5, 0)))
		t.Name = "ScareTrigger"
		t.CanTouch = true
		t:SetAttribute("ScareType", scares[k])
		t:SetAttribute("Stage", 4)
		table.insert(triggers, t)
	end

	local ghostSpawns = {
		maze.center(0, H - 1),
		maze.center(W - 1, H - 1),
		maze.center(0, 4),
		maze.center(W - 1, 4),
	}
	local patrol = {}
	for _, cell in ipairs(maze.cells) do
		table.insert(patrol, cell.pos)
	end

	local spawn = invisible(f, Vector3.new(1, 1, 1), CFrame.lookAt(maze.entry + Vector3.new(0, 3, 2), maze.entry + Vector3.new(0, 3, 12)))
	spawn.Name = "StageSpawn"

	return {
		Folder = f,
		Spawn = spawn,
		Portal = maze.portal,
		Door = maze.door,
		GeneratorPrompt = genPrompt,
		SetFuseSlot = setFuseSlot,
		SetPowered = setPowered,
		FuseSpots = fuseSpots,
		Triggers = triggers,
		GhostSpawns = ghostSpawns,
		Patrol = patrol,
		Dynamic = folder("Dynamic", f),
	}
end

-- ================= หน้าจบ =================

local function buildEnding(root)
	local O = Config.Origins[5]
	local f = folder("Ending", root)
	local rng = Random.new(55)

	part(f, Vector3.new(160, 2, 160), CFrame.new(O + Vector3.new(0, -1, 60)), Color3.fromRGB(85, 150, 70), M.Grass)
	part(f, Vector3.new(10, 0.2, 120), CFrame.new(O + Vector3.new(0, 0.1, 60)), Color3.fromRGB(170, 140, 100), M.Sand)
	invisible(f, Vector3.new(2, 40, 160), CFrame.new(O + Vector3.new(-60, 20, 60)), true)
	invisible(f, Vector3.new(2, 40, 160), CFrame.new(O + Vector3.new(60, 20, 60)), true)
	invisible(f, Vector3.new(120, 40, 2), CFrame.new(O + Vector3.new(0, 20, -4)), true)
	invisible(f, Vector3.new(120, 40, 2), CFrame.new(O + Vector3.new(0, 20, 125)), true)

	-- ต้นไม้เขียว
	for _ = 1, 26 do
		local x = (rng:NextNumber() < 0.5 and -1 or 1) * rng:NextNumber(12, 55)
		local pos = O + Vector3.new(x, 0, rng:NextNumber(5, 120))
		local h = rng:NextNumber(8, 14)
		part(f, Vector3.new(1.6, h, 1.6), CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color3.fromRGB(100, 70, 45), M.Wood)
		part(f, Vector3.new(9, 9, 9), CFrame.new(pos + Vector3.new(0, h + 2, 0)), Color3.fromRGB(60, rng:NextInteger(130, 170), 60), M.Grass, { Shape = Enum.PartType.Ball })
	end
	-- ดอกไม้
	local flowerColors = { Color3.fromRGB(255, 120, 160), Color3.fromRGB(255, 230, 90), Color3.fromRGB(150, 140, 255), Color3.new(1, 1, 1) }
	for _ = 1, 80 do
		local pos = O + Vector3.new(rng:NextNumber(-55, 55), 0.3, rng:NextNumber(2, 120))
		if math.abs(pos.X - O.X) > 6 then
			part(f, Vector3.new(0.6, 0.6, 0.6), CFrame.new(pos), flowerColors[rng:NextInteger(1, #flowerColors)], M.SmoothPlastic, { CanCollide = false, Shape = Enum.PartType.Ball })
		end
	end

	-- ซุ้มประตูทางออก
	local white = Color3.fromRGB(235, 230, 220)
	part(f, Vector3.new(2, 14, 2), CFrame.new(O + Vector3.new(-7, 7, 40)), white, M.Marble)
	part(f, Vector3.new(2, 14, 2), CFrame.new(O + Vector3.new(7, 7, 40)), white, M.Marble)
	sign(f, Vector3.new(18, 4, 1.5), CFrame.lookAt(O + Vector3.new(0, 15, 40), O + Vector3.new(0, 15, 0)), {
		{ Text = "ทางออก", Color = Color3.fromRGB(60, 120, 60) },
	}, white)

	sign(f, Vector3.new(40, 14, 1), CFrame.lookAt(O + Vector3.new(0, 12, 80), O + Vector3.new(0, 12, 0)), {
		{ Text = "คุณรอดแล้ว!", Color = Color3.fromRGB(255, 220, 90), Weight = 2 },
		{ Text = "THANK YOU FOR PLAYING", Font = Enum.Font.Creepster, Color = Color3.new(1, 1, 1), Weight = 1 },
	}, Color3.fromRGB(40, 70, 40))

	local spawn = invisible(f, Vector3.new(1, 1, 1), CFrame.lookAt(O + Vector3.new(0, 3, 10), O + Vector3.new(0, 3, 50)))
	spawn.Name = "StageSpawn"
	return { Folder = f, Spawn = spawn }
end

-- ================= Build ทั้งหมด =================

function MapBuilder.build()
	if Config.RemoveBaseplate then
		local bp = workspace:FindFirstChild("Baseplate")
		if bp then
			bp:Destroy()
		end
	end
	local old = workspace:FindFirstChild("HorrorMap")
	if old then
		old:Destroy()
	end
	local root = Instance.new("Folder")
	root.Name = "HorrorMap"

	local map = {
		Root = root,
		Lobby = buildLobby(root),
		Stages = {
			[1] = buildStage1(root),
			[2] = buildStage2(root),
			[3] = buildStage3(root),
			[4] = buildStage4(root),
			[5] = buildEnding(root),
		},
	}
	root.Parent = workspace
	return map
end

MapBuilder.FlickerTag = FLICKER_TAG

return MapBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[--[[
	Remotes : สร้าง RemoteEvent ทั้งหมดไว้ที่ ReplicatedStorage.HorrorRemotes
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NAMES = {
	"Jumpscare", -- server -> client (ชนิดตุ้งแช่)
	"Notify", -- server -> client (ข้อความ, สี)
	"StageChanged", -- server -> client (ด่าน, ชื่อด่าน, เป้าหมาย)
	"Objective", -- server -> client (ข้อความเป้าหมาย)
	"Transition", -- server -> client (จอดำตอนวาป)
	"GameEnded", -- server -> client (เวลาที่ใช้)
	"PlaySound", -- server -> client (ชื่อเสียงใน Config.Sounds)
	"Flashlight", -- client -> server (เปิด/ปิดไฟฉาย)
	"ReturnToLobby", -- client -> server
}

local folder = ReplicatedStorage:FindFirstChild("HorrorRemotes") or Instance.new("Folder")
folder.Name = "HorrorRemotes"

local Remotes = {}
for _, name in ipairs(NAMES) do
	local r = folder:FindFirstChild(name) or Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = folder
	Remotes[name] = r
end
folder.Parent = ReplicatedStorage

return Remotes
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Run</string><ProtectedString name="Source"><![CDATA[--[[
	Run : ควบคุมการเล่น 1 รอบ (ทีมเดียวต่อเซิร์ฟเวอร์)
	ด่าน 1 -> 2 -> 3 -> 4 -> หน้าจบ(5)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("HorrorShared"):WaitForChild("Config"))
local MapBuilder = require(script.Parent.MapBuilder)
local Ghosts = require(script.Parent.Ghosts)
local Remotes = require(script.Parent.Remotes)

local Run = {
	Active = false,
	Finished = false,
	Stage = 0,
	Id = 0,
	Players = {}, -- [player] = true
	PartySize = 1,
	StartTime = 0,
	Objective = "",
	Advancing = false,
	IsGameServer = false,
}

local Map
local RED = Color3.fromRGB(255, 70, 70)
local GREEN = Color3.fromRGB(110, 255, 130)
local GOLD = Color3.fromRGB(255, 215, 90)

-- ================= Utilities =================

local function runPlayers()
	local list = {}
	for p in pairs(Run.Players) do
		if p.Parent then
			table.insert(list, p)
		end
	end
	return list
end

local function notifyAll(msg, color)
	for _, p in ipairs(runPlayers()) do
		Remotes.Notify:FireClient(p, msg, color)
	end
end

local function soundAll(name)
	for _, p in ipairs(runPlayers()) do
		Remotes.PlaySound:FireClient(p, name)
	end
end

local function setObjective(text)
	Run.Objective = text
	for _, p in ipairs(runPlayers()) do
		Remotes.Objective:FireClient(p, text)
	end
end

local function playerFromHit(hit)
	local model = hit:FindFirstAncestorOfClass("Model")
	while model do
		local p = Players:GetPlayerFromCharacter(model)
		if p then
			return p
		end
		model = model.Parent and model.Parent:FindFirstAncestorOfClass("Model")
	end
	return nil
end

local function shuffle(t)
	local c = table.clone(t)
	for i = #c, 2, -1 do
		local j = math.random(i)
		c[i], c[j] = c[j], c[i]
	end
	return c
end

local function ghostCount(cfg)
	return cfg.Count + math.floor((Run.PartySize - 1) / cfg.ExtraPer)
end

local function spawnCFrame(stage, index)
	local base = Map.Stages[stage].Spawn.CFrame
	local i = (index or 1) - 1
	return base * CFrame.new(((i % 3) - 1) * 4, 0, -math.floor(i / 3) * 4)
end

local function teleportPlayer(p, stage, index)
	local char = p.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		char:PivotTo(spawnCFrame(stage, index))
	end
end

local function indexOf(p)
	local i = 0
	for _, other in ipairs(runPlayers()) do
		i += 1
		if other == p then
			return i
		end
	end
	return 1
end

-- ช่วยให้โค้ดที่หน่วงเวลาไว้ไม่ทำงานถ้ารอบ/ด่านเปลี่ยนไปแล้ว
local function stillValid(id, stage)
	return Run.Active and Run.Id == id and Run.Stage == stage
end

-- ================= อาวุธ (ด่าน 3) =================

local function makeWeapon()
	local tool = Instance.new("Tool")
	tool.Name = Config.Weapon.Name
	tool.CanBeDropped = false
	tool.ToolTip = "คลิกเพื่อขับไล่ผี"
	tool:SetAttribute("HorrorWeapon", true)
	tool.Grip = CFrame.new(0, -0.6, 0)

	local gold = Color3.fromRGB(255, 210, 90)
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.4, 3, 0.4)
	handle.Color = gold
	handle.Material = Enum.Material.Metal
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool
	local bar = Instance.new("Part")
	bar.Name = "Bar"
	bar.Size = Vector3.new(1.8, 0.4, 0.4)
	bar.Color = gold
	bar.Material = Enum.Material.Metal
	bar.CanCollide = false
	bar.Massless = true
	bar.CFrame = handle.CFrame * CFrame.new(0, 0.7, 0)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = bar
	weld.Parent = handle
	bar.Parent = tool
	local l = Instance.new("PointLight")
	l.Color = gold
	l.Range = 8
	l.Brightness = 1
	l.Parent = handle

	local last = 0
	tool.Activated:Connect(function()
		if os.clock() - last < Config.Weapon.Cooldown then
			return
		end
		last = os.clock()
		local char = tool.Parent
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then
			return
		end
		-- แสงศักดิ์สิทธิ์
		local burst = Instance.new("Part")
		burst.Shape = Enum.PartType.Ball
		burst.Size = Vector3.new(2, 2, 2)
		burst.Color = gold
		burst.Material = Enum.Material.Neon
		burst.Anchored = true
		burst.CanCollide = false
		burst.CanQuery = false
		burst.CanTouch = false
		burst.Transparency = 0.3
		burst.CFrame = CFrame.new(root.Position + root.CFrame.LookVector * 5)
		burst.Parent = workspace
		TweenService:Create(burst, TweenInfo.new(0.35), { Size = Vector3.new(14, 14, 14), Transparency = 1 }):Play()
		Debris:AddItem(burst, 0.4)

		for _, g in ipairs(Ghosts.inRange(3, root.Position, Config.Weapon.Range)) do
			local to = g.pos - root.Position
			local flat = Vector3.new(to.X, 0, to.Z)
			if flat.Magnitude < 5 or root.CFrame.LookVector:Dot(flat.Unit) > 0.2 then
				Ghosts.damage(g, Config.Weapon.Damage)
			end
		end
	end)
	return tool
end

local function applyLoadout(p)
	local wantWeapon = Run.Players[p] == true and Run.Stage == 3
	local backpack = p:FindFirstChildOfClass("Backpack")
	local existing = {}
	for _, container in ipairs({ backpack, p.Character }) do
		if container then
			for _, c in ipairs(container:GetChildren()) do
				if c:IsA("Tool") and c:GetAttribute("HorrorWeapon") then
					table.insert(existing, c)
				end
			end
		end
	end
	if wantWeapon then
		if #existing == 0 and backpack then
			makeWeapon().Parent = backpack
		end
	else
		for _, t in ipairs(existing) do
			t:Destroy()
		end
	end
end

-- ================= การตั้งค่าแต่ละด่าน =================

local setup, cleanup = {}, {}

local function spawnChasers(stage, cfg, id)
	local s = Map.Stages[stage]
	task.delay(Config.Ghosts.SpawnDelay, function()
		if not stillValid(id, stage) then
			return
		end
		for i = 1, ghostCount(cfg) do
			Ghosts.spawn({
				position = s.GhostSpawns[((i - 1) % #s.GhostSpawns) + 1],
				stage = stage,
				speed = cfg.Speed,
				damage = cfg.Damage,
				detectRange = cfg.DetectRange,
				patrolPoints = s.Patrol,
				name = "Ghost",
			})
		end
		notifyAll("ได้ยินเสียงอะไรบางอย่าง... มันกำลังมา", RED)
		soundAll("Whisper")
	end)
end

-- ----- ด่าน 1 -----
setup[1] = function()
	Run.Triggered = {}
	MapBuilder.setPortal(Map.Stages[1].Portal, true)
	Run.Objective = Config.Stages[1].Objective
end

-- ----- ด่าน 2 -----
setup[2] = function(id)
	local s = Map.Stages[2]
	Run.HasKey = false
	s.Door.close()
	MapBuilder.setPortal(s.Portal, false)

	local spot = s.KeySpots[math.random(#s.KeySpots)]
	local key, prompt = MapBuilder.makePickup(s.Dynamic, spot, "Key")
	prompt.Triggered:Connect(function(p)
		if not Run.Players[p] or Run.HasKey or not stillValid(id, 2) then
			return
		end
		Run.HasKey = true
		key:Destroy()
		soundAll("Pickup")
		notifyAll(p.DisplayName .. " เจอกุญแจแล้ว! รีบไปที่ประตูทางออกทางทิศเหนือ", GOLD)
		setObjective("นำกุญแจไปไขประตูทางออก (สุดทางทิศเหนือ)")
		-- ผีโกรธ วิ่งเร็วขึ้น
		for _, g in ipairs(Ghosts.forStage(2)) do
			g.speed += 2
			g.detect += 40
		end
		Remotes.Jumpscare:FireClient(p, "Whisper")
	end)

	spawnChasers(2, Config.Ghosts.Stage2, id)
	Run.Objective = Config.Stages[2].Objective
end

-- ----- ด่าน 3 -----
local function spawnStage3Ghost(id, index)
	local s = Map.Stages[3]
	local cfg = Config.Ghosts.Stage3
	Ghosts.spawn({
		position = s.GhostSpawns[((index - 1) % #s.GhostSpawns) + 1],
		stage = 3,
		speed = cfg.Speed,
		damage = cfg.Damage,
		detectRange = cfg.DetectRange,
		health = cfg.Health,
		patrolPoints = s.Patrol,
		name = "Ghost",
		onDeath = function()
			if not stillValid(id, 3) or Run.BossDead then
				return
			end
			task.delay(cfg.RespawnDelay, function()
				if stillValid(id, 3) and not Run.BossDead then
					spawnStage3Ghost(id, math.random(#s.GhostSpawns))
				end
			end)
		end,
	})
end

local function updateCandleObjective()
	local total = Config.Quest.Candles
	if Run.CandlesPlaced >= total then
		return
	end
	setObjective(string.format("เทียนวิญญาณ: เก็บแล้ว %d  |  วางแล้ว %d/%d  (นำไปวางที่แท่นบูชา)", Run.CandlesFound, Run.CandlesPlaced, total))
end

setup[3] = function(id)
	local s = Map.Stages[3]
	Run.CandlesFound, Run.CandlesHeld, Run.CandlesPlaced = 0, 0, 0
	Run.BossSpawned, Run.BossDead = false, false
	for k = 1, Config.Quest.Candles do
		s.SetSlotLit(k, false)
	end
	s.AltarPrompt.Enabled = true
	MapBuilder.setPortal(s.Portal, false)

	local spots = shuffle(s.CandleSpots)
	for i = 1, math.min(Config.Quest.Candles, #spots) do
		local candle, prompt = MapBuilder.makePickup(s.Dynamic, spots[i], "Candle")
		prompt.Triggered:Connect(function(p)
			if not Run.Players[p] or not candle.Parent or not stillValid(id, 3) then
				return
			end
			candle:Destroy()
			Run.CandlesFound += 1
			Run.CandlesHeld += 1
			soundAll("Pickup")
			notifyAll(p.DisplayName .. " เก็บเทียนวิญญาณได้ (" .. Run.CandlesFound .. "/" .. Config.Quest.Candles .. ")", Color3.fromRGB(140, 210, 255))
			updateCandleObjective()
		end)
	end

	task.delay(Config.Ghosts.SpawnDelay, function()
		if not stillValid(id, 3) then
			return
		end
		for i = 1, ghostCount(Config.Ghosts.Stage3) do
			spawnStage3Ghost(id, i)
		end
		notifyAll("วิญญาณร้ายตื่นแล้ว! ใช้ไม้กางเขน (คลิก) ขับไล่มัน", RED)
	end)

	Run.Objective = string.format("เก็บเทียนวิญญาณ %d เล่ม แล้วนำไปวางที่แท่นบูชากลางสุสาน", Config.Quest.Candles)
end

local function onAltar(p)
	local s = Map.Stages[3]
	if not Run.Players[p] or Run.Stage ~= 3 or Run.BossSpawned then
		return
	end
	if Run.CandlesHeld <= 0 then
		Remotes.Notify:FireClient(p, "ยังไม่มีเทียนวิญญาณ... ไปหามาก่อน", RED)
		return
	end
	for _ = 1, Run.CandlesHeld do
		Run.CandlesPlaced += 1
		s.SetSlotLit(Run.CandlesPlaced, true)
	end
	Run.CandlesHeld = 0
	updateCandleObjective()

	if Run.CandlesPlaced < Config.Quest.Candles then
		notifyAll("วางเทียนแล้ว " .. Run.CandlesPlaced .. "/" .. Config.Quest.Candles, Color3.fromRGB(140, 210, 255))
		return
	end

	-- ครบแล้ว => บอสเกิด
	Run.BossSpawned = true
	s.AltarPrompt.Enabled = false
	local id = Run.Id
	for _, other in ipairs(runPlayers()) do
		Remotes.Jumpscare:FireClient(other, "Face")
	end
	notifyAll("พิธีกรรมสำเร็จ... แต่ผีเจ้าที่ตื่นขึ้นมาแล้ว!! สู้กับมัน!", RED)
	setObjective("ปราบผีเจ้าที่ให้ได้!")
	local cfg = Config.Ghosts.Boss
	Ghosts.spawn({
		position = s.BossSpawn,
		stage = 3,
		scale = cfg.Scale,
		speed = cfg.Speed,
		damage = cfg.Damage,
		detectRange = cfg.DetectRange,
		health = cfg.Health + cfg.HealthPerPlayer * (Run.PartySize - 1),
		patrolPoints = s.Patrol,
		color = Color3.fromRGB(200, 170, 170),
		name = "BossGhost",
		onDeath = function()
			if not stillValid(id, 3) then
				return
			end
			Run.BossDead = true
			Ghosts.clearStage(3)
			MapBuilder.setPortal(s.Portal, true)
			soundAll("Portal")
			notifyAll("ปราบผีเจ้าที่ได้แล้ว! ประตูวาปเปิดทางทิศเหนือ", GREEN)
			setObjective("ไปที่ประตูวาปทางทิศเหนือของสุสาน")
		end,
	})
end

-- ----- ด่าน 4 -----
local function updateFuseObjective()
	setObjective(string.format("ฟิวส์: เก็บแล้ว %d  |  ใส่แล้ว %d/%d  (เครื่องปั่นไฟอยู่ที่จุดเริ่มต้น)", Run.FusesFound, Run.FusesPlaced, Config.Quest.Fuses))
end

setup[4] = function(id)
	local s = Map.Stages[4]
	Run.FusesFound, Run.FusesHeld, Run.FusesPlaced = 0, 0, 0
	Run.Powered = false
	Run.Triggered = {}
	s.Door.close()
	s.SetPowered(false)
	for k = 1, Config.Quest.Fuses do
		s.SetFuseSlot(k, false)
	end
	s.GeneratorPrompt.Enabled = true
	MapBuilder.setPortal(s.Portal, false)

	local spots = shuffle(s.FuseSpots)
	for i = 1, math.min(Config.Quest.Fuses, #spots) do
		local fuse, prompt = MapBuilder.makePickup(s.Dynamic, spots[i], "Fuse")
		prompt.Triggered:Connect(function(p)
			if not Run.Players[p] or not fuse.Parent or not stillValid(id, 4) then
				return
			end
			fuse:Destroy()
			Run.FusesFound += 1
			Run.FusesHeld += 1
			soundAll("Pickup")
			notifyAll(p.DisplayName .. " เจอฟิวส์! (" .. Run.FusesFound .. "/" .. Config.Quest.Fuses .. ")", GREEN)
			updateFuseObjective()
			-- เก็บของแล้วโดนตุ้งแช่บ้าง
			if math.random() < 0.5 then
				Remotes.Jumpscare:FireClient(p, "Behind")
			end
		end)
	end

	spawnChasers(4, Config.Ghosts.Stage4, id)
	Run.Objective = string.format("หาฟิวส์ %d อัน มาใส่เครื่องปั่นไฟที่จุดเริ่มต้น แล้วหนีออกไป", Config.Quest.Fuses)
end

local function onGenerator(p)
	local s = Map.Stages[4]
	if not Run.Players[p] or Run.Stage ~= 4 or Run.Powered then
		return
	end
	if Run.FusesHeld <= 0 then
		Remotes.Notify:FireClient(p, "ยังไม่มีฟิวส์... ไปหาในตึกก่อน", RED)
		return
	end
	for _ = 1, Run.FusesHeld do
		Run.FusesPlaced += 1
		s.SetFuseSlot(Run.FusesPlaced, true)
	end
	Run.FusesHeld = 0
	if Run.FusesPlaced < Config.Quest.Fuses then
		updateFuseObjective()
		notifyAll("ใส่ฟิวส์แล้ว " .. Run.FusesPlaced .. "/" .. Config.Quest.Fuses, GREEN)
		return
	end

	Run.Powered = true
	s.GeneratorPrompt.Enabled = false
	s.SetPowered(true)
	s.Door.open()
	MapBuilder.setPortal(s.Portal, true)
	soundAll("Door")
	for _, other in ipairs(runPlayers()) do
		Remotes.Jumpscare:FireClient(other, "Rush")
	end
	for _, g in ipairs(Ghosts.forStage(4)) do
		g.speed = Config.Ghosts.Stage4.RageSpeed
		g.detect = 999
	end
	notifyAll("ไฟมาแล้ว! ประตูทางออกเปิดแล้ว วิ่งไปทางทิศเหนือ!! ผีคลั่งแล้ว!", RED)
	setObjective("วิ่งไปที่ประตูทางออกทางทิศเหนือ แล้วเข้าประตูวาป!")
end

-- ----- หน้าจบ -----
setup[5] = function()
	Run.Finished = true
	Run.Objective = Config.Stages[5].Objective
	local elapsed = os.clock() - Run.StartTime
	task.delay(1.5, function()
		for _, p in ipairs(runPlayers()) do
			Remotes.GameEnded:FireClient(p, elapsed, Run.IsGameServer and not RunService:IsStudio())
		end
	end)
end

cleanup[2] = function()
	Map.Stages[2].Dynamic:ClearAllChildren()
end
cleanup[3] = function()
	Map.Stages[3].Dynamic:ClearAllChildren()
end
cleanup[4] = function()
	Map.Stages[4].Dynamic:ClearAllChildren()
end

-- ================= Flow =================

local function enterStage(stage)
	local prev = Run.Stage
	Run.Stage = stage
	if prev >= 1 then
		Ghosts.clearStage(prev)
		if cleanup[prev] then
			cleanup[prev]()
		end
	end
	setup[stage](Run.Id)
	for i, p in ipairs(runPlayers()) do
		p:SetAttribute("Stage", stage)
		local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 then
			hum.Health = hum.MaxHealth
		end
		teleportPlayer(p, stage, i)
		applyLoadout(p)
		Remotes.StageChanged:FireClient(p, stage, Config.Stages[stage].Name, Run.Objective)
	end
end

function Run.start(players)
	if Run.Active or #players == 0 then
		return false
	end
	Run.Active = true
	Run.Finished = false
	Run.Advancing = false
	Run.Id += 1
	Run.Stage = 0
	Run.Players = {}
	Run.PartySize = #players
	Run.StartTime = os.clock()
	for _, p in ipairs(players) do
		Run.Players[p] = true
		p:SetAttribute("InRun", true)
		Remotes.Transition:FireClient(p)
	end
	task.wait(0.8)
	enterStage(1)
	return true
end

function Run.addPlayer(p)
	if not Run.Active or Run.Players[p] then
		return
	end
	Run.Players[p] = true
	p:SetAttribute("InRun", true)
	p:SetAttribute("Stage", Run.Stage)
	teleportPlayer(p, Run.Stage, indexOf(p))
	applyLoadout(p)
	Remotes.StageChanged:FireClient(p, Run.Stage, Config.Stages[Run.Stage].Name, Run.Objective)
end

function Run.reset()
	Run.Id += 1
	for stage = 1, 4 do
		Ghosts.clearStage(stage)
		if cleanup[stage] then
			cleanup[stage]()
		end
	end
	Map.Stages[2].Door.close()
	Map.Stages[4].Door.close()
	Map.Stages[4].SetPowered(false)
	for stage = 2, 4 do
		MapBuilder.setPortal(Map.Stages[stage].Portal, false)
	end
	MapBuilder.setPortal(Map.Stages[1].Portal, true)
	for p in pairs(Run.Players) do
		p:SetAttribute("InRun", nil)
		p:SetAttribute("Stage", nil)
	end
	Run.Players = {}
	Run.Active = false
	Run.Finished = false
	Run.Stage = 0
	Run.Advancing = false
end

local function sendToLobby(p)
	Run.Players[p] = nil
	p:SetAttribute("InRun", nil)
	p:SetAttribute("Stage", nil)
	applyLoadout(p)
	local char = p.Character
	if char then
		char:PivotTo(Map.Lobby.Spawn.CFrame + Vector3.new(math.random(-3, 3), 4, math.random(-3, 3)))
	end
	Remotes.StageChanged:FireClient(p, 0, "ล็อบบี้", "")
	if #runPlayers() == 0 then
		Run.reset()
	end
end

-- ================= Init =================

local function onCharacter(p, char)
	local hum = char:WaitForChild("Humanoid", 10)
	local head = char:WaitForChild("Head", 10)
	if not hum or not head then
		return
	end
	hum.WalkSpeed = Config.WalkSpeed

	local flash = Instance.new("SpotLight")
	flash.Name = "Flashlight"
	flash.Range = 55
	flash.Angle = 50
	flash.Brightness = 2.5
	flash.Color = Color3.fromRGB(255, 244, 214)
	flash.Shadows = true
	flash.Face = Enum.NormalId.Front
	flash.Parent = head

	hum.Died:Connect(function()
		if Run.Players[p] and Run.Active and not Run.Finished then
			notifyAll(p.DisplayName .. " ถูกผีจับได้แล้ว...", RED)
		end
	end)

	if Run.Players[p] and Run.Stage >= 1 then
		task.delay(0.15, function()
			if Run.Players[p] and p.Character == char then
				teleportPlayer(p, Run.Stage, indexOf(p))
				applyLoadout(p)
			end
		end)
	end
end

function Run.init(map, isGameServer)
	Map = map
	Run.IsGameServer = isGameServer

	Ghosts.onPlayerHit = function(p)
		Remotes.Jumpscare:FireClient(p, "Hit")
	end

	-- ประตูวาปทุกด่าน
	for stage = 1, 4 do
		local core = Map.Stages[stage].Portal
		core.Touched:Connect(function(hit)
			local p = playerFromHit(hit)
			if not p or not Run.Players[p] or not Run.Active then
				return
			end
			if Run.Stage ~= stage or not core:GetAttribute("Active") or Run.Advancing then
				return
			end
			Run.Advancing = true
			local id = Run.Id
			notifyAll(p.DisplayName .. " เข้าประตูวาป! กำลังวาปทั้งทีม...", Color3.fromRGB(200, 140, 255))
			for _, other in ipairs(runPlayers()) do
				Remotes.Transition:FireClient(other)
				Remotes.PlaySound:FireClient(other, "Portal")
			end
			task.delay(0.8, function()
				if Run.Active and Run.Id == id and Run.Stage == stage then
					enterStage(stage + 1)
				end
				Run.Advancing = false
			end)
		end)
	end

	-- จุดตุ้งแช่ (ด่าน 1 และ 4)
	for _, stage in ipairs({ 1, 4 }) do
		for _, trig in ipairs(Map.Stages[stage].Triggers) do
			trig.Touched:Connect(function(hit)
				local p = playerFromHit(hit)
				if not p or not Run.Players[p] or p:GetAttribute("Stage") ~= stage then
					return
				end
				Run.Triggered = Run.Triggered or {}
				Run.Triggered[trig] = Run.Triggered[trig] or {}
				if Run.Triggered[trig][p] then
					return
				end
				Run.Triggered[trig][p] = true
				Remotes.Jumpscare:FireClient(p, trig:GetAttribute("ScareType"))
			end)
		end
	end

	-- ประตูด่าน 2
	local s2 = Map.Stages[2]
	s2.Door.Prompt.Triggered:Connect(function(p)
		if not Run.Players[p] or Run.Stage ~= 2 or s2.Door.IsOpen then
			return
		end
		if not Run.HasKey then
			Remotes.Notify:FireClient(p, "ประตูล็อกอยู่... ต้องหากุญแจก่อน", RED)
			return
		end
		s2.Door.open()
		MapBuilder.setPortal(s2.Portal, true)
		soundAll("Door")
		notifyAll(p.DisplayName .. " ไขประตูแล้ว! รีบเข้าประตูวาป!", GREEN)
		setObjective("เข้าประตูวาปหลังประตูทางออก")
	end)

	-- ประตูด่าน 4 (เปิดเองเมื่อไฟมา)
	Map.Stages[4].Door.Prompt.Triggered:Connect(function(p)
		if Run.Players[p] and Run.Stage == 4 and not Run.Powered then
			Remotes.Notify:FireClient(p, "ประตูไฟฟ้าไม่ทำงาน... ต้องใส่ฟิวส์ให้เครื่องปั่นไฟก่อน", RED)
		end
	end)

	Map.Stages[3].AltarPrompt.Triggered:Connect(onAltar)
	Map.Stages[4].GeneratorPrompt.Triggered:Connect(onGenerator)

	-- ไฟฉาย
	Remotes.Flashlight.OnServerEvent:Connect(function(p, on)
		local head = p.Character and p.Character:FindFirstChild("Head")
		local flash = head and head:FindFirstChild("Flashlight")
		if flash then
			flash.Enabled = on == true
		end
	end)

	-- กลับล็อบบี้หลังจบเกม
	Remotes.ReturnToLobby.OnServerEvent:Connect(function(p)
		if not Run.Players[p] or not Run.Finished then
			return
		end
		if Run.IsGameServer and not RunService:IsStudio() then
			local ok, err = pcall(function()
				TeleportService:TeleportAsync(game.PlaceId, { p })
			end)
			if ok then
				return
			end
			warn("[Run] Teleport to lobby failed: " .. tostring(err))
		end
		sendToLobby(p)
	end)

	local function hookPlayer(p)
		p.CharacterAdded:Connect(function(char)
			onCharacter(p, char)
		end)
		if p.Character then
			task.spawn(onCharacter, p, p.Character)
		end
	end
	Players.PlayerAdded:Connect(hookPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		hookPlayer(p)
	end

	Players.PlayerRemoving:Connect(function(p)
		if Run.Players[p] then
			Run.Players[p] = nil
			if Run.Active and #runPlayers() == 0 then
				Run.reset()
			end
		end
	end)
end

return Run
]]></ProtectedString></Properties></Item>
</Item>
