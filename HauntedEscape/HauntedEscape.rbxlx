end
for _, x in ipairs({ 0.3, 0.7 }) do
	local eye = facePart({ Position = UDim2.fromScale(x, 0.4), Size = UDim2.fromScale(0.26, 0.17), BackgroundColor3 = Color3.new(0, 0, 0) })
	corner(eye, 0.5)
